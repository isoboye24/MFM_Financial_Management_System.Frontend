<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- PAGE -->
    <!-- ===================================================== -->

    <!-- PAGE TITLE -->

    <Style x:Key="PageTitle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="28"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

    </Style>


    <!-- PAGE DESCRIPTION -->

    <Style x:Key="PageDescription"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryTextBrush}"/>

    </Style>


    <!-- ===================================================== -->
    <!-- SECTION -->
    <!-- ===================================================== -->

    <Style x:Key="SectionTitle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="18"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

    </Style>


    <!-- ===================================================== -->
    <!-- FORM -->
    <!-- ===================================================== -->

    <!-- FORM LABEL -->

    <Style x:Key="FormLabel"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

        <Setter Property="Margin"
                Value="0,0,0,8"/>

    </Style>


    <!-- FORM BREADCRUMB -->

    <Style x:Key="FormBreadcrumb"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="10"/>

        <Setter Property="Foreground"
                Value="{DynamicResource MutedTextBrush}"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- CURRENT FORM BREADCRUMB -->

    <Style x:Key="FormBreadcrumbCurrent"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="10"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- FORM TITLE -->

    <Style x:Key="FormTitle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="20"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

    </Style>


    <!-- FORM DESCRIPTION -->

    <Style x:Key="FormDescription"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="10"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryTextBrush}"/>

    </Style>


    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <!-- TABLE HEADER -->

    <Style x:Key="TableHeader"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="12"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryTextBrush}"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- TABLE TEXT -->

    <Style x:Key="TableText"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- TABLE SECONDARY TEXT -->

    <Style x:Key="TableSecondaryText"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="12"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryTextBrush}"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- ===================================================== -->
    <!-- CARD -->
    <!-- ===================================================== -->

    <!-- CARD TITLE -->

    <Style x:Key="CardTitle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="16"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

    </Style>


    <!-- CARD AMOUNT -->

    <Style x:Key="CardAmount"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="20"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

    </Style>


    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <!-- SIDEBAR MENU TEXT -->

    <Style x:Key="SidebarMenuText"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="16"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SidebarTextBrush}"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- SIDEBAR CHURCH NAME -->

    <Style x:Key="SidebarChurchName"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="18"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SidebarTextBrush}"/>

    </Style>


    <!-- ===================================================== -->
    <!-- EMPTY / HELPER TEXT -->
    <!-- ===================================================== -->

    <Style x:Key="EmptyStateText"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="Foreground"
                Value="{DynamicResource MutedTextBrush}"/>

        <Setter Property="TextAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="FieldDescription"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="11"/>

        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryTextBrush}"/>

    </Style>

</ResourceDictionary>