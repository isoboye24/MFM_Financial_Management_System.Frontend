<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- TOP BAR ICONS -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="WindowControlPressedBrush" Color="#D5D5D5"/>

    <!-- ===================================================== -->
    <!-- PRIMARY -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="#5B4CF3"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4E40D9"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#4033C2"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FB"/>

    <!-- ===================================================== -->
    <!-- LIGHT PRIMARY -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="PrimaryHoverBackgroundBrush" Color="#EEE9FF"/>
    <SolidColorBrush x:Key="PrimaryPressedBackgroundBrush" Color="#DDD5FF"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#172033"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#667085"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="PrimaryPurple" Color="#5B4BDB"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#16A36A"/>
    <SolidColorBrush x:Key="InfoBlue" Color="#3182E8"/>
    <SolidColorBrush x:Key="WarningOrange" Color="#FF9D2E"/>

    <!-- ===================================================== -->
    <!-- APPLICATION COLORS -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#98A2B3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TableBorderBrush" Color="#EAECF0"/>

    <!-- ===================================================== -->
    <!-- STATUS -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#16A36A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3182E8"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>

    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="#F8F9FB"/>


    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#171B45"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarIconBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#5B4CF3"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2A2F63"/>

    <!-- Recent records table header -->
    <Style x:Key="TableHeaderContainer"
       TargetType="Border">
        <Setter Property="Background" Value="#E8ECF4"/>
        <Setter Property="Padding" Value="5,6"/>
    </Style>

    <!-- Category badge -->
    <SolidColorBrush x:Key="OfferingBadgeBackgroundBrush" Color="#EAE7FF"/>
    <SolidColorBrush x:Key="CategoryBadgeTextBrush" Color="#5946D2"/>

    <!-- Chart -->
    <SolidColorBrush x:Key="ChartLabelBrush" Color="#68708A"/>
    <SolidColorBrush x:Key="ChartSeparatorBrush" Color="#E8EAF2"/>
    <SolidColorBrush x:Key="ChartPointBorderBrush" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="ChartSeriesBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ChartAreaBrush" Color="#23F59E0B"/>
    
    <SolidColorBrush x:Key="ChartSeriesBrushMale" Color="#6654D9"/>
    <SolidColorBrush x:Key="ChartAreaBrushMale" Color="#236654D9"/>
    
    <SolidColorBrush x:Key="ChartSeriesBrushFemale" Color="#EC4899"/>
    <SolidColorBrush x:Key="ChartAreaBrushFemale" Color="#23EC4899"/>
    
    <SolidColorBrush x:Key="ChartSeriesBrushChildren" Color="#14B8A6"/>
    <SolidColorBrush x:Key="ChartAreaBrushChildren" Color="#2314B8A6"/>

    <SolidColorBrush x:Key="ChartLabelBrush2" Color="#667085"/>
    <SolidColorBrush x:Key="ChartSeparatorBrush2" Color="#EAECF0"/>

    <!-- Input controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#172033"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D0D5DD"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#F5F3FF"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="#6654D9"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#98A2B3"/>

    <!-- Dropdown and calendar -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#F2F0FF"/>
    <SolidColorBrush x:Key="PopupSelectedBrush" Color="#6654D9"/>
    <SolidColorBrush x:Key="PopupSelectedTextBrush" Color="#FFFFFF"/>



</ResourceDictionary>