<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- ===================================================== -->
    <!-- PRIMARY -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="PrimaryBrush"
             Color="#5B4CF3"/>

    <SolidColorBrush x:Key="PrimaryHoverBrush"
             Color="#4E40D9"/>

    <SolidColorBrush x:Key="PrimaryPressedBrush"
             Color="#4033C2"/>


    <!-- ===================================================== -->
    <!-- LIGHT PRIMARY -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="PrimaryHoverBackgroundBrush"
             Color="#EEE9FF"/>

    <SolidColorBrush x:Key="PrimaryPressedBackgroundBrush"
             Color="#DDD5FF"/>

    <SolidColorBrush x:Key="PrimaryText"
                     Color="#172033"/>

    <SolidColorBrush x:Key="SecondaryText"
                     Color="#667085"/>

    <SolidColorBrush x:Key="BorderColor"
                     Color="#E5E7EB"/>

    <SolidColorBrush x:Key="BackgroundColor"
                     Color="#F5F7FB"/>

    <SolidColorBrush x:Key="PrimaryPurple"
                     Color="#5B4BDB"/>

    <SolidColorBrush x:Key="SuccessGreen"
                     Color="#16A36A"/>

    <SolidColorBrush x:Key="InfoBlue"
                     Color="#3182E8"/>

    <SolidColorBrush x:Key="WarningOrange"
                     Color="#FF9D2E"/>



    <!-- ===================================================== -->
    <!-- APPLICATION COLORS -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="AppBackgroundBrush"
                 Color="#F5F7FB"/>

    <SolidColorBrush x:Key="SurfaceBrush"
                 Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PrimaryTextBrush"
                 Color="#172033"/>

    <SolidColorBrush x:Key="SecondaryTextBrush"
                 Color="#667085"/>

    <SolidColorBrush x:Key="MutedTextBrush"
                 Color="#98A2B3"/>

    <SolidColorBrush x:Key="BorderBrush"
                 Color="#E5E7EB"/>

    <SolidColorBrush x:Key="TableBorderBrush"
                 Color="#EAECF0"/>


    <!-- ===================================================== -->
    <!-- STATUS -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="SuccessBrush"
                 Color="#16A36A"/>

    <SolidColorBrush x:Key="InfoBrush"
                 Color="#3182E8"/>

    <SolidColorBrush x:Key="WarningBrush"
                 Color="#F59E0B"/>

    <SolidColorBrush x:Key="DangerBrush"
                 Color="#E5484D"/>


    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <SolidColorBrush x:Key="TableAlternateRowBrush"
                 Color="#F8F9FB"/>


    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush"
                 Color="#171B45"/>

    <SolidColorBrush x:Key="SidebarTextBrush"
                 Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SidebarIconBrush"
                 Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SidebarActiveBrush"
                 Color="#5B4CF3"/>


    <SolidColorBrush x:Key="SidebarHoverBrush"
                 Color="#2A2F63"/>

</ResourceDictionary>