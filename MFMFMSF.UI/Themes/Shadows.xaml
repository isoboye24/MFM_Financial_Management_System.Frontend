<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- SMALL SHADOW -->
    <!-- ===================================================== -->

    <DropShadowEffect x:Key="SmallShadow"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Opacity="0.05"
                      Color="#000000"/>


    <!-- ===================================================== -->
    <!-- CARD SHADOW -->
    <!-- ===================================================== -->

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="18"
                      ShadowDepth="2"
                      Opacity="0.07"
                      Color="#000000"/>


    <!-- ===================================================== -->
    <!-- LARGE SHADOW -->
    <!-- ===================================================== -->

    <DropShadowEffect x:Key="LargeShadow"
                      BlurRadius="25"
                      ShadowDepth="3"
                      Opacity="0.10"
                      Color="#000000"/>

</ResourceDictionary>