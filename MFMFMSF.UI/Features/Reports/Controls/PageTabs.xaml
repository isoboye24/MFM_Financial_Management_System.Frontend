<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.PageTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>

        <Style x:Key="TabButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="#303653"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid>

        <Border Background="White"
                BorderBrush="#E8EAF2"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- FINANCIAL SUMMARY -->
                <!-- ================================================= -->

                <Button Grid.Column="0"
                        Tag="0"
                        Click="Tab_Click"
                        Style="{StaticResource TabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="ChartBoxOutline"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Financial Summary"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- INCOME REPORTS -->
                <!-- ================================================= -->

                <Button Grid.Column="1"
                        Tag="1"
                        Click="Tab_Click"
                        Style="{StaticResource TabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="CashPlus"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Income Reports"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- EXPENDITURE REPORTS -->
                <!-- ================================================= -->

                <Button Grid.Column="2"
                        Tag="2"
                        Click="Tab_Click"
                        Style="{StaticResource TabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="CashMinus"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Expenditure Reports"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- PROJECT REPORTS -->
                <!-- ================================================= -->

                <Button Grid.Column="3"
                        Tag="3"
                        Click="Tab_Click"
                        Style="{StaticResource TabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="BriefcaseOutline"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Project Reports"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- BUDGET REPORTS -->
                <!-- ================================================= -->

                <Button Grid.Column="4"
                        Tag="4"
                        Click="Tab_Click"
                        Style="{StaticResource TabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="Calculator"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Budget Reports"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- CUSTOM REPORTS -->
                <!-- ================================================= -->

                <Button Grid.Column="5"
                        Tag="5"
                        Click="Tab_Click"
                        Style="{StaticResource TabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="FileChartOutline"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Custom Reports"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- ACTIVE TAB INDICATOR -->
                <!-- ================================================= -->

                <Border x:Name="ActiveIndicator"
                        Grid.Column="0"
                        Height="2"
                        Background="#5B4CF3"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="8,0,8,0"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>