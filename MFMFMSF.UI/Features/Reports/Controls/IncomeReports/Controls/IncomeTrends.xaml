<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.IncomeReports.Controls.IncomeTrends"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converterControls="clr-namespace:MFMFMSF.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converterControls:IncomeSeriesColorConverter
        x:Key="IncomeSeriesColorConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Income Trends"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="{Binding SelectedYear,
                                      StringFormat='Monthly income comparison for {0}'}"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- SUMMARY CARDS -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,24">

                <!-- OFFERINGS -->
                <Border Background="{DynamicResource PrimaryHoverBackgroundBrush}"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Offerings"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding OfferingsTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TITHES -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource InfoBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Tithes"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding TithesTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="{DynamicResource InfoBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SEEDS -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Seeds (Faith Promise)"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding SeedsTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- OTHER INCOME -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">

                    <StackPanel>
                        <TextBlock Text="Other Income"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding OtherIncomeTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- MONTHLY MULTI-LINE CHART -->

            <!-- MONTHLY MULTI-LINE CHART -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <lvc:CartesianChart Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        Series="{Binding IncomeSeries}"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}"
                        ZoomMode="X"
                        TooltipPosition="Top"
                        MinHeight="280"/>

                <!-- Theme-aware custom legend -->
                <ItemsControl Grid.Row="1"
                  ItemsSource="{Binding IncomeSeries}"
                  HorizontalAlignment="Center"
                  Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0">
                                <Ellipse Width="10"
                             Height="10"
                             Fill="{Binding Name,
                                 Converter={StaticResource IncomeSeriesColorConverter}}"
                             Margin="0,0,6,0"/>

                                <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>


        </Grid>
    </Border>
</UserControl>
