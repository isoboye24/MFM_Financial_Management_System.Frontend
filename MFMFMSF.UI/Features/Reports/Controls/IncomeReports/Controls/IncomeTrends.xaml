<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.IncomeReports.Controls.IncomeTrends"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000"
             Background="#F5F7FB">

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Income Trends"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#151936"/>

                    <TextBlock Text="{Binding SelectedYear,
                                      StringFormat='Monthly income comparison for {0}'}"
                               FontSize="13"
                               Foreground="#68708A"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Grid>

            <!-- SUMMARY CARDS -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,24">

                <!-- OFFERINGS -->
                <Border Background="#F7F4FF"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Offerings"
                                   Foreground="#68708A"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding OfferingsTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="#6048EE"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TITHES -->
                <Border Background="#F0F6FF"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Tithes"
                                   Foreground="#68708A"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding TithesTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="#3784ED"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SEEDS -->
                <Border Background="#EFFAF5"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Seeds (Faith Promise)"
                                   Foreground="#68708A"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding SeedsTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="#28A879"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- OTHER INCOME -->
                <Border Background="#FFF7EB"
                        CornerRadius="10"
                        Padding="14">

                    <StackPanel>
                        <TextBlock Text="Other Income"
                                   Foreground="#68708A"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding OtherIncomeTotal,
                                          StringFormat='€ {0:N2}'}"
                                   Foreground="#E99A2E"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- MONTHLY MULTI-LINE CHART -->
            <lvc:CartesianChart Grid.Row="2"
                                Series="{Binding IncomeSeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                LegendPosition="Bottom"
                                ZoomMode="X"
                                TooltipPosition="Top"
                                MinHeight="280"/>

        </Grid>
    </Border>
</UserControl>