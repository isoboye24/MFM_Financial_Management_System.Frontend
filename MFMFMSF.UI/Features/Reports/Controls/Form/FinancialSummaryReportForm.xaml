<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.Form.FinancialSummaryReportForm"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- LABEL -->
        <!-- ===================================================== -->

        <Style x:Key="FormLabel"
   TargetType="TextBlock">

            <Setter Property="FontSize"
        Value="14"/>

            <Setter Property="FontWeight"
        Value="SemiBold"/>

            <Setter Property="Foreground"
        Value="#151936"/>

            <Setter Property="Margin"
        Value="0,0,0,5"/>

        </Style>


        <!-- ===================================================== -->
        <!-- HELPER TEXT -->
        <!-- ===================================================== -->

        <Style x:Key="FormHelperText"
   TargetType="TextBlock">

            <Setter Property="FontSize"
        Value="10"/>

            <Setter Property="Foreground"
        Value="#68708A"/>

            <Setter Property="Margin"
        Value="0,5,0,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TEXT BOX -->
        <!-- ===================================================== -->

        <Style x:Key="FormTextBox"
   TargetType="TextBox">

            <Setter Property="Height"
        Value="36"/>

            <Setter Property="FontSize"
        Value="14"/>

            <Setter Property="Foreground"
        Value="#303653"/>

            <Setter Property="Background"
        Value="White"/>

            <Setter Property="BorderBrush"
        Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
        Value="1"/>

            <Setter Property="Padding"
        Value="10,0"/>

        </Style>



        <!-- ===================================================== -->
        <!-- DATE PICKER -->
        <!-- ===================================================== -->

        <Style x:Key="FormDatePicker"
   TargetType="DatePicker">

            <Setter Property="Height"
        Value="36"/>

            <Setter Property="FontSize"
        Value="14"/>

            <Setter Property="Foreground"
        Value="#303653"/>

            <Setter Property="Background"
        Value="White"/>

            <Setter Property="BorderBrush"
        Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
        Value="1"/>

        </Style>


        <!-- ===================================================== -->
        <!-- NUMBER BOX -->
        <!-- ===================================================== -->

        <Style x:Key="NumberBoxStyle"
   TargetType="TextBox"
   BasedOn="{StaticResource FormTextBox}">

            <Setter Property="TextAlignment"
        Value="Left"/>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border Background="White"
        BorderBrush="#E8EAF2"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================================================= -->
                    <!-- DATE -->
                    <!-- ================================================= -->
                    <StackPanel Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,0,12">

                        <!-- ================================================= -->
                        <!-- MONTH AND YEAR PICKER -->
                        <!-- ================================================= -->
                        <TextBlock Text="Month and Year *"
                            Style="{StaticResource FormLabel}"/>                       

                        <controls:MonthYearPicker x:Name="MonthYearPicker"/>

                        <TextBlock Text="Select the month and year of the report."
                            Style="{StaticResource FormHelperText}"/>

                    </StackPanel>



                    <!-- ================================================= -->
                    <!-- OPENING BALANCE -->
                    <!-- ================================================= -->
                    <StackPanel Grid.Row="0"
                     Grid.Column="2"
                     Margin="0,0,0,12">

                        <TextBlock Text="Opening Balance"
                        Style="{StaticResource FormLabel}"/>

                        <TextBox
                         Text="{Binding OpeningBalance,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"/>

                        <TextBlock Text="Enter the opening balance of the report."
                        Style="{StaticResource FormHelperText}"/>

                    </StackPanel>
                </Grid>

            </StackPanel>

        </Grid>

    </Border>
</UserControl>
