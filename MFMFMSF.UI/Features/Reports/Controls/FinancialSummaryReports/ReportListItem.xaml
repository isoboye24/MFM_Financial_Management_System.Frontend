<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports.ReportListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="30"
             d:DesignWidth="320">

    <Grid Height="30">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="75"/>
        </Grid.ColumnDefinitions>


        <!-- DOCUMENT ICON -->

        <Border Grid.Column="0"
                Width="18"
                Height="18"
                Background="#F4F3FF"
                CornerRadius="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

            <materialDesign:PackIcon
                Kind="FileDocumentOutline"
                Width="11"
                Height="11"
                Foreground="#303653"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        </Border>


        <!-- REPORT INFORMATION -->

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">

            <TextBlock
                Text="{Binding Title,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="8"
                FontWeight="SemiBold"
                Foreground="#151936"/>

            <TextBlock
                Text="{Binding GeneratedText,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="6.5"
                Foreground="#6D7188"
                Margin="0,1,0,0"/>

        </StackPanel>


        <!-- ACTIONS -->

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">


            <!-- PREVIEW -->

            <Button
                Width="22"
                Height="22"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                ToolTip="Preview"
                Command="{Binding PreviewCommand,
                          RelativeSource={RelativeSource AncestorType=UserControl}}">

                <materialDesign:PackIcon
                    Kind="EyeOutline"
                    Width="11"
                    Height="11"
                    Foreground="#303653"/>

            </Button>


            <!-- DOWNLOAD -->

            <Button
                Width="22"
                Height="22"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                ToolTip="Download"
                Command="{Binding DownloadCommand,
                          RelativeSource={RelativeSource AncestorType=UserControl}}">

                <materialDesign:PackIcon
                    Kind="Download"
                    Width="11"
                    Height="11"
                    Foreground="#303653"/>

            </Button>


            <!-- DELETE -->

            <Button
                Width="22"
                Height="22"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                ToolTip="Delete"
                Command="{Binding DeleteCommand,
                          RelativeSource={RelativeSource AncestorType=UserControl}}">

                <materialDesign:PackIcon
                    Kind="DeleteOutline"
                    Width="11"
                    Height="11"
                    Foreground="#303653"/>

            </Button>

        </StackPanel>

    </Grid>

</UserControl>