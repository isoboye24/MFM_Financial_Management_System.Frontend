<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports.FinancialSummaryTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports"
             xmlns:lvc="clr-namespace:MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          Margin="0,20,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RECENT REPORTS -->
        <Border Grid.Row="0"
                Background="Transparent">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="220"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TableBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Margin="0,0,0,20">

                    <lvc:RecentReports
                        x:Name="RecentReportsControl"/>

                </Border>
            </Grid>
        </Border>

        <!-- INCOME VS EXPENDITURE TREND -->
        <Border Grid.Row="2"
                Height="400"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource TableBorderBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Margin="0,0,0,20">

            <lvc:IncomeVsExpenditureTrend
                x:Name="IncomeVsExpenditureTrendControl"/>

        </Border>

    </Grid>
</UserControl>
