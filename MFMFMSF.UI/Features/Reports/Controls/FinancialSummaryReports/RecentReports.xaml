<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports.RecentReports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="250"
             d:DesignWidth="320">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Grid.Row="0"
                       Text="Recent Reports"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <!-- REPORT LIST -->
            <Grid Grid.Row="1">

                <ItemsControl ItemsSource="{Binding RecentReports}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Grid MinHeight="43" Margin="0,2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <!-- PDF ICON -->
                                <Border Grid.Column="0"
                                        Width="20"
                                        Height="20"
                                        Background="#F4F3FF"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="FileDocumentOutline"
                                        Width="12"
                                        Height="12"
                                        Foreground="#6654D9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>

                                <!-- REPORT DETAILS -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="4,0">

                                    <TextBlock
                                        Text="{Binding MonthName, StringFormat='Financial Summary — {0}'}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Text="{Binding Year, StringFormat='Reporting year: {0}'}"
                                        FontSize="9"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Margin="0,2,0,0"/>

                                </StackPanel>

                                <!-- DOWNLOAD BUTTON -->
                                <Button Grid.Column="2"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Cursor="Hand"
                                        ToolTip="Download PDF"
                                        Command="{Binding DataContext.DownloadReportCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">

                                    <materialDesign:PackIcon
                                        Kind="Download"
                                        Width="14"
                                        Height="14"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Button>

                            </Grid>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- LOADING -->
                <TextBlock Text="Loading reports..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- EMPTY STATE -->
                <TextBlock Text="No reports available."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasReports}" Value="False"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    Margin="0,8,0,0">

                <controls:ViewAllButton
                    Text="View all reports  →"
                    Command="{Binding ViewAllReportsCommand}"/>

            </Border>

        </Grid>
    </Border>
</UserControl>