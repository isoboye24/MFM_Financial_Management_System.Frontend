<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports.SummaryByFunds"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="600">

    <UserControl.Resources>

        <Style x:Key="SmallText"
           TargetType="TextBlock">

            <Setter Property="FontSize"
                Value="8"/>

            <Setter Property="Foreground"
                Value="#303653"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>

        </Style>

    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ========================================== -->
            <!-- TITLE -->
            <!-- ========================================== -->

            <TextBlock Grid.Row="0"
                       Text="Summary by Fund (This Month)"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#151936"
                       Margin="0,0,0,12"/>


            <!-- ========================================== -->
            <!-- COLUMN HEADERS -->
            <!-- ========================================== -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Fund"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1"
                           Text="Income"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="2"
                           Text="Expenditure"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="3"
                           Text="Net Income"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="4"
                           Text="Budget"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="5"
                           Text="Utilization"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"/>

            </Grid>


            <!-- ========================================== -->
            <!-- GENERAL FUND -->
            <!-- ========================================== -->

            <Grid Grid.Row="2"
                  Height="40">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="General Fund"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="$98,320.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="$65,450.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="$32,870.00"
                           Style="{StaticResource SmallText}"
                           Foreground="#0DAA68"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="$120,000.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center">

                    <TextBlock Text="54.5%"
                               FontSize="7"
                               Foreground="#7B8197"/>

                    <Border Height="4"
                            Margin="0,3,10,0"
                            Background="#EEF1F4"
                            CornerRadius="2">

                        <Border Width="35"
                                HorizontalAlignment="Left"
                                Background="#35B58C"
                                CornerRadius="2"/>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ========================================== -->
            <!-- BUILDING FUND -->
            <!-- ========================================== -->

            <Grid Grid.Row="3"
                  Height="40">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Building Fund"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="$25,600.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="$12,300.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="$13,300.00"
                           Style="{StaticResource SmallText}"
                           Foreground="#0DAA68"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="$30,000.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center">

                    <TextBlock Text="41.0%"
                               FontSize="7"
                               Foreground="#7B8197"/>

                    <Border Height="4"
                            Margin="0,3,10,0"
                            Background="#EEF1F4"
                            CornerRadius="2">

                        <Border Width="28"
                                HorizontalAlignment="Left"
                                Background="#35B58C"
                                CornerRadius="2"/>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ========================================== -->
            <!-- MISSIONS FUND -->
            <!-- ========================================== -->

            <Grid Grid.Row="4"
                  Height="40">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Missions Fund"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="$14,100.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="$7,200.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="$6,900.00"
                           Style="{StaticResource SmallText}"
                           Foreground="#0DAA68"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="$15,000.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center">

                    <TextBlock Text="48.0%"
                               FontSize="7"
                               Foreground="#7B8197"/>

                    <Border Height="4"
                            Margin="0,3,10,0"
                            Background="#EEF1F4"
                            CornerRadius="2">

                        <Border Width="31"
                                HorizontalAlignment="Left"
                                Background="#35B58C"
                                CornerRadius="2"/>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ========================================== -->
            <!-- BENEVOLENCE FUND -->
            <!-- ========================================== -->

            <Grid Grid.Row="5"
                  Height="40">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Benevolence Fund"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="$10,300.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="$2,500.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="$7,800.00"
                           Style="{StaticResource SmallText}"
                           Foreground="#0DAA68"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="$10,000.00"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center">

                    <TextBlock Text="25.0%"
                               FontSize="7"
                               Foreground="#7B8197"/>

                    <Border Height="4"
                            Margin="0,3,10,0"
                            Background="#EEF1F4"
                            CornerRadius="2">

                        <Border Width="18"
                                HorizontalAlignment="Left"
                                Background="#35B58C"
                                CornerRadius="2"/>

                    </Border>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>