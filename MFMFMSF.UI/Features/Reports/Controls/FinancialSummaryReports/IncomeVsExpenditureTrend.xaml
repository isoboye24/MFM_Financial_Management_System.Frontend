<UserControl x:Class="MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports.IncomeVsExpenditureTrend"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <TextBlock Grid.Column="0"
                           Text="Income vs Expenditure Trend"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#151936"
                           VerticalAlignment="Center"/>


                <!-- PERIOD BUTTONS -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="Monthly"
                            Width="45"
                            Height="24"
                            FontSize="8"
                            Foreground="#5B4CF3"
                            Background="White"
                            BorderBrush="#B8AEFF"
                            BorderThickness="1"
                            Padding="2"/>

                    <Button Content="Quarterly"
                            Width="45"
                            Height="24"
                            FontSize="8"
                            Foreground="#303653"
                            Background="White"
                            BorderBrush="#E8EAF2"
                            BorderThickness="1"
                            Padding="2"/>

                    <Button Content="Yearly"
                            Width="45"
                            Height="24"
                            FontSize="8"
                            Foreground="#303653"
                            Background="White"
                            BorderBrush="#E8EAF2"
                            BorderThickness="1"
                            Padding="2"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- LEGEND -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="5,0,0,5">

                <!-- INCOME -->

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,25,0">

                    <Ellipse Width="7"
                             Height="7"
                             Fill="#35B58C"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="Income"
                               FontSize="8"
                               Foreground="#303653"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <!-- EXPENDITURE -->

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,25,0">

                    <Ellipse Width="7"
                             Height="7"
                             Fill="#F0445F"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="Expenditure"
                               FontSize="8"
                               Foreground="#303653"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <!-- NET INCOME -->

                <StackPanel Orientation="Horizontal">

                    <Rectangle Width="7"
                               Height="7"
                               Fill="#6046D8"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Net Income"
                               FontSize="8"
                               Foreground="#303653"
                               Margin="5,0,0,0"/>

                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- CHART -->
            <!-- ================================================= -->

            <lvc:CartesianChart Grid.Row="2"
                                Series="{Binding Series}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                LegendPosition="Hidden"
                                ZoomMode="None"
                                TooltipPosition="Top"
                                Background="Transparent"/>

        </Grid>

    </Border>

</UserControl>