<UserControl x:Class="MFMFMSF.UI.Features.Reports.Views.ReportPDFPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Style="{DynamicResource  CardBorderStyle}"
                Margin="16,16,16,10"
                Padding="12">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="Print"
                            Style="{DynamicResource  SecondaryButtonStyle}"
                            Command="{Binding PrintCommand}"
                            Margin="4,0"/>

                    <Button
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding DownloadCommand}"
                        Click="DownloadPdfButton_Click"
                        Margin="4,0"
                        ToolTip="Download PDF">

                        <materialDesign:PackIcon
                            Kind="DownloadOutline"
                            Width="18"
                            Height="18"/> 
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="←"
                            Width="34"
                            Command="{Binding PreviousPageCommand}"
                            Margin="2,0"/>

                    <TextBlock Text="{Binding CurrentPage}"
                               Style="{DynamicResource  BodyTextStyle}"
                               VerticalAlignment="Center"
                               Margin="8,0,2,0"/>

                    <TextBlock Text="/"
                               Style="{DynamicResource  BodyTextStyle}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalPages}"
                               Style="{DynamicResource  BodyTextStyle}"
                               VerticalAlignment="Center"
                               Margin="2,0,8,0"/>

                    <Button Content="→"
                            Width="34"
                            Command="{Binding NextPageCommand}"
                            Margin="2,0"/>

                    <Separator Width="1"
                               Height="24"
                               Margin="12,0"
                               Background="Gray"/>

                    <Button Content="−"
                            Width="34"
                            Command="{Binding ZoomOutCommand}"
                            Margin="2,0"/>

                    <TextBlock Text="{Binding ZoomPercentage}"
                               Style="{DynamicResource  BodyTextStyle}"
                               VerticalAlignment="Center"
                               Width="52"
                               TextAlignment="Center"/>

                    <Button Content="+"
                            Width="34"
                            Command="{Binding ZoomInCommand}"
                            Margin="2,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- PDF viewer -->
        <Border Grid.Row="1"
                Margin="16,0,16,16"
                Background="#FFE9EDF2"
                CornerRadius="8"
                ClipToBounds="True">

            <Grid>
                <wv2:WebView2 x:Name="PdfWebView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

                <TextBlock x:Name="LoadingText"
                           Text="Loading PDF..."
                           Style="{DynamicResource  BodyTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
