<UserControl x:Class="MFMFMSF.UI.Features.Reports.Views.ViewAllFSReports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Reports.Views" 
             xmlns:Iv1="clr-namespace:MFMFMSF.UI.Features.Reports.Controls.FinancialSummaryReports" 
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F7FB">
    <Grid Margin="20">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Margin="0,0,0,20">

            <controls:FormTitle
                BreadcrumbText="Church Reports"
                CurrentPageText="View All Service Reports"
                Title="View All Service Reports"
                Description="View all church service reports"
                NavigationService="{Binding NavigationService,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,20">
            <Iv1:ReportsTable />
        </Border>


        <Border Grid.Row="2">
            
            <controls:PaginationButtons 
                 TotalItems="{Binding TotalReports}"
                CurrentPage="{Binding CurrentPage}"
                PageChanged="Pagination_PageChanged"/>
            
        </Border>
    </Grid>
</UserControl>
