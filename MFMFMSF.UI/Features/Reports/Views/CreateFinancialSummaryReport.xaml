<UserControl x:Class="MFMFMSF.UI.Features.Reports.Views.CreateFinancialSummaryReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:MFMFMSF.UI.Features.Expenditures.Views" 
         xmlns:controls="clr-namespace:MFMFMSF.UI.Controls" 
        xmlns:controls2="clr-namespace:MFMFMSF.UI.Features.Reports.Controls.Form"
             mc:Ignorable="d" 
         d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="#F5F7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
    Margin="0,0,0,20">

            <controls:FormTitle
    BreadcrumbText="Church Financial Summary Report"
    CurrentPageText="Create Financial Summary Report"
    Title="Create Financial Summary Report"
    Description="Create a new church financial summary report to track and manage reports."
    NavigationService="{Binding NavigationService,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </Border>

        <Border Grid.Row="1"
            Margin="0,0,0,20">

            <controls2:FinancialSummaryReportForm
                SelectedMonth="{Binding Month, Mode=TwoWay}"
                SelectedYear="{Binding Year, Mode=TwoWay}"
                OpeningBalance="{Binding OpeningBalance, Mode=TwoWay}"/>

        </Border>

        <Border Grid.Row="2"
            Margin="0,0,0,20">

            <controls:GenerateReportButton
                IsLoading="{Binding IsGenerating}"
                Command="{Binding GenerateReportCommand}"/>

        </Border>

    </Grid>
</UserControl>
