<UserControl x:Class="MFMFMSF.UI.Features.OtherIncome.Controls.OtherIncomeQuickActionCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="250"
            d:DesignWidth="350">
    <!-- ================================================= -->
    <!-- MAIN CARD -->
    <!-- ================================================= -->

    <Border Background="#FFFFFF"
        BorderBrush="#EAECF0"
        BorderThickness="1"
        CornerRadius="12"
        Padding="13">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Title -->
                <RowDefinition Height="Auto"/>

                <!-- Buttons -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ============================================ -->
            <!-- TITLE -->
            <!-- ============================================ -->

            <TextBlock Grid.Row="0"
                   Text="Quick Actions"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#172033"
                   Margin="0,0,0,8"/>


            <!-- ============================================ -->
            <!-- QUICK ACTION BUTTONS -->
            <!-- ============================================ -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ======================================== -->
                <!-- ROW 1 -->
                <!-- ======================================== -->


                <!-- Record Offering -->

                <controls:QuickActionCard
                Grid.Row="0"
                Grid.Column="0"
                Title="Record Offering"
                Icon="GiftOutline"
                IconBackground="#6654D9"/>


                <!-- Record Tithe -->

                <controls:QuickActionCard
                Grid.Row="0"
                Grid.Column="1"
                Title="Record Tithe"
                Icon="HeartOutline"
                IconBackground="#35B58C"/>


                <!-- ======================================== -->
                <!-- ROW 2 -->
                <!-- ======================================== -->


                <!-- Add Expenditure -->

                <controls:QuickActionCard
                Grid.Row="1"
                Grid.Column="0"
                Title="Add Expenditure"
                Icon="ReceiptTextOutline"
                IconBackground="#EF5B83"/>


                <!-- Generate Report -->

                <controls:QuickActionCard
                Grid.Row="1"
                Grid.Column="1"
                Title="Generate Report"
                Icon="FileDocumentOutline"
                IconBackground="#3182E8"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>
