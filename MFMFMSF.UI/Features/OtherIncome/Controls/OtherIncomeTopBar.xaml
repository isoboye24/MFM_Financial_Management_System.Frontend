<UserControl x:Class="MFMFMSF.UI.Features.OtherIncome.Controls.OtherIncomeTopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Seeds.Controls" 
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <controls:PageTitle
                Title="Other Income"
                Description="View and manage all other income of the church."/>
        </Border>

        <Border Grid.Column="1">
            <controls:MonthYearPicker
                Margin="0,0,12,0"
                PeriodChanged="MonthYearPicker_PeriodChanged"/>
        </Border>

    </Grid>
</UserControl>
