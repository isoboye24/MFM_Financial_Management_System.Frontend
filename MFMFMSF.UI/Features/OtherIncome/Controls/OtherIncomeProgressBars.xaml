<UserControl x:Class="MFMFMSF.UI.Features.OtherIncome.Controls.OtherIncomeProgressBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls">

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================= TITLE ================= -->

            <TextBlock Grid.Row="0"
                       Text="Income by Category (This Month)"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#151936"
                       Margin="0,0,0,8"/>


            <!-- ================= PROGRESS BARS ================= -->

            <StackPanel Grid.Row="1">


                <!-- FACILITY RENTAL -->

                <controls:ProgressBarWithLabelAndAmount
                    Label="Facility Rental"
                    Amount="$1,000.00 (33.8%)"
                    Percentage="33.8"
                    BarForeground="#6654D9"/>


                <!-- DONATIONS -->

                <controls:ProgressBarWithLabelAndAmount
                    Label="Donations"
                    Amount="$810.00 (27.4%)"
                    Percentage="27.4"
                    BarForeground="#35B58C"/>


                <!-- EVENT INCOME -->

                <controls:ProgressBarWithLabelAndAmount
                    Label="Event Income"
                    Amount="$500.00 (16.9%)"
                    Percentage="16.9"
                    BarForeground="#FF9D2E"/>


                <!-- MINISTRY INCOME -->

                <controls:ProgressBarWithLabelAndAmount
                    Label="Ministry Income"
                    Amount="$330.00 (11.1%)"
                    Percentage="11.1"
                    BarForeground="#3182E8"/>


                <!-- OTHERS -->

                <controls:ProgressBarWithLabelAndAmount
                    Label="Others"
                    Amount="$350.00 (11.8%)"
                    Percentage="11.8"
                    BarForeground="#ED6685"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>