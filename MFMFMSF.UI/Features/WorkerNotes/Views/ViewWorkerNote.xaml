<UserControl x:Class="MFMFMSF.UI.Features.WorkerNotes.Views.ViewWorkerNote"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- Note action button -->
        <Style x:Key="NotePageActionButton"
               TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
        Margin="0,0,0,20"
            Padding="20"
            Background="{DynamicResource SurfaceBrush}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    
                    <controls:FormTitle
                        BreadcrumbText="Worker Notes"
                        CurrentPageText="View Worker Note"
                        Title="View Worker Note"
                        Description="View the complete information about this worker note."
                        NavigationService="{Binding NavigationService,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                
                </Border>

                <Border Grid.Column="1"
        VerticalAlignment="Center"
        Margin="12,0,0,0">

                    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                        <!-- Edit Note -->
                        <Button Width="38"
                            Height="38"
                            Margin="0,0,8,0"
                            ToolTip="Edit Note"
                            Click="EditNote_Click"
                            Style="{StaticResource SecondaryIconButtonStyle}">

                            <materialDesign:PackIcon Kind="PencilOutline"
                             Width="17"
                             Height="17"/>
                        </Button>

                        <!-- Delete Note -->
                        <Button Width="38"
                            Height="38"
                            ToolTip="Delete Note"
                            Click="DeleteNote_Click"
                            Style="{StaticResource DangerIconButtonStyle}">

                            <materialDesign:PackIcon Kind="TrashCanOutline"
                             Width="17"
                             Height="17"/>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>

            

        </Border>

        <!-- ================================================= -->
        <!-- NOTE CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MAIN NOTE CONTENT -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TableBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="26"
                        Margin="0,0,12,0">

                    <StackPanel>

                        <!-- Note icon and category -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,22">

                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="11"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#xE70B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="13,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="NOTE'S DETAILS"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>

                            </StackPanel>
                        </StackPanel>

                        <!-- Note title -->
                        <TextBlock Text="{Binding WorkerNote.NoteTitle}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <!-- Metadata -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,22">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,7,0"/>

                                <TextBlock Text="{Binding WorkerNote.CreationTime,
                                    StringFormat='{}{0:dd MMMM yyyy}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding WorkerNote.CreationTime,
                                StringFormat='{}{0:HH:mm}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,24"/>

                        <!-- Note body -->
                        <TextBlock Text="NOTE DETAILS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding WorkerNote.Note}"
                                   FontSize="13"
                                   LineHeight="23"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </Border>


                <!-- WORKER'S INFORMATION CARD -->
                <Border Grid.Column="1"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource TableBorderBrush}"
        BorderThickness="1"
        CornerRadius="15"
        Padding="20">

                    <StackPanel>

                        <!-- TITLE -->
                        <TextBlock Text="Worker's Information"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

                        <!-- PROFILE IMAGE -->
                        <Border Width="100"
                Height="100"
                CornerRadius="50"
                Background="{DynamicResource PrimaryLightBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                Margin="0,0,0,12">

                            <TextBlock Text="&#xE77B;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="44"
                       Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- FULL NAME -->
                        <TextBlock FontSize="19"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,7">
            <Run Text="{Binding Worker.FirstName}"/>
            <Run Text=" "/>
            <Run Text="{Binding Worker.LastName}"/>
                        </TextBlock>

                        <!-- POSITION -->
                        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">

                            <TextBlock Text="&#xE734;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,7,0"/>

                            <TextBlock Text="{Binding Worker.PositionName}"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- GENDER AND REGISTRATION DATE BADGES -->
                        <WrapPanel HorizontalAlignment="Center"
                   Margin="0,0,0,20">

                            <!-- GENDER BADGE -->
                            <Border Background="{DynamicResource PrimaryLightBrush}"
                    CornerRadius="5"
                    Padding="10,6"
                    Margin="0,0,6,5">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                                    <TextBlock Text="{Binding Worker.GenderName}"
                               FontSize="10"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- REGISTRATION DATE BADGE -->
                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                    BorderBrush="{DynamicResource TableBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,6"
                    Margin="0,0,0,5">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="&#xE787;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                                    <TextBlock Text="{Binding Worker.CreatedAt,
                                      StringFormat='{}{0:MMM d, yyyy}'}"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>


                        <!-- SEPARATOR -->
                        <Border Height="1"
        Background="{DynamicResource BorderBrush}"
        Margin="0,0,0,18"/>

                        <!-- CONTACT INFORMATION -->
                        <StackPanel>

                            <!-- SECTION HEADER -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="40"
                Height="40"
                CornerRadius="10"
                Background="{DynamicResource PrimaryLightBrush}"
                VerticalAlignment="Center">

                                    <TextBlock Text="&#xE77B;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="19"
                       Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                                    <TextBlock Text="Contact Information"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <TextBlock Text="Contact details and residential address of this worker."
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- EMAIL AND PHONE -->
                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- EMAIL ADDRESS -->
                                <Border Grid.Column="0"
                Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource TableBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14"
                Margin="0,0,8,0">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">

                                            <TextBlock Text="&#xE715;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                                            <TextBlock Text="EMAIL ADDRESS"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Worker.Email}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- PHONE NUMBER -->
                                <Border Grid.Column="1"
                Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource TableBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14"
                Margin="8,0,0,0">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">

                                            <TextBlock Text="&#xE717;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                                            <TextBlock Text="PHONE NUMBER"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Worker.PhoneNumber}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </Grid>

                            <!-- RESIDENTIAL ADDRESS -->
                            <Border Background="{DynamicResource SurfaceVariantBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="14">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                    Width="36"
                    Height="36"
                    CornerRadius="9"
                    Background="{DynamicResource PrimaryLightBrush}"
                    VerticalAlignment="Center">

                                        <TextBlock Text="&#xE707;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                                        <TextBlock Text="RESIDENTIAL ADDRESS"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,7"/>

                                        <TextBlock Text="{Binding Worker.Address}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>