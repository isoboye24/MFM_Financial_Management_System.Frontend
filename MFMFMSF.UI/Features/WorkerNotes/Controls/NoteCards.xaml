<UserControl x:Class="MFMFMSF.UI.Features.WorkerNotes.Controls.NoteCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="400">

    <!-- MAIN CARD -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="15"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================= -->
            <!-- HEADER -->
            <!-- ============================================= -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ICON -->
                <Border Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource PrimaryLightBrush}"
                        VerticalAlignment="Top">

                    <TextBlock Text="&#xE70B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <!-- TITLE AND DESCRIPTION -->
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Recent Notes"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Latest updates and notes about this worker."
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

            <!-- ============================================= -->
            <!-- NOTES LIST -->
            <!-- ============================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding RecentNotes}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <controls:NoteCard
                                NoteTitle="{Binding NoteTitle}"
                                Note="{Binding Note}"
                                CreationTime="{Binding CreationTime}"/>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>
