<UserControl x:Class="MFMFMSF.UI.Features.Settings.Controls.Categories.GivingCategories.GivingCategoriesList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         mc:Ignorable="d"
         d:DesignHeight="450"
         d:DesignWidth="800">

    <UserControl.Resources>

        <!-- ================================================= -->
        <!-- ACTION BUTTON STYLE -->
        <!-- ================================================= -->

        <Style x:Key="ActionButtonStyle"
           TargetType="Button">

            <Setter Property="Width"
                Value="30"/>

            <Setter Property="Height"
                Value="30"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Foreground"
                Value="#68708A"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Padding"
                Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Style.Triggers>

                <!-- Hover -->

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#F1F0FF"/>

                    <Setter Property="Foreground"
                        Value="#5B4CF3"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================================= -->
        <!-- DELETE BUTTON STYLE -->
        <!-- ================================================= -->

        <Style x:Key="DeleteButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonStyle}">

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#FFF0F2"/>

                    <Setter Property="Foreground"
                        Value="#F0445F"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Border Background="White"
        BorderBrush="#E8EAF2"
        BorderThickness="1"
        CornerRadius="8">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TABLE HEADER -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                Background="#F8F9FC"
                CornerRadius="8,8,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>


                    <!-- NUMBER -->

                    <TextBlock Grid.Column="0"
                           Text="No."
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#68708A"/>


                    <!-- NAME -->

                    <TextBlock Grid.Column="1"
                           Text="Name"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#68708A"/>


                    <!-- ACTIONS -->

                    <TextBlock Grid.Column="2"
                           Text="Actions"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#68708A"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- TABLE CONTENT -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="GivingCategoriesItemsControl">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border BorderBrush="#E8EAF2"
                            BorderThickness="0,0,0,1">

                                <Grid Height="44">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- NUMBER -->

                                    <TextBlock Grid.Column="0"
                                   Text="{Binding Number}"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#68708A"/>


                                    <!-- NAME -->

                                    <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#303653"/>


                                    <!-- ACTIONS -->

                                    <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                        <Button Style="{StaticResource ActionButtonStyle}"
                                        ToolTip="Edit"
                                        Click="EditGivingButton_Click"
                                        Tag="{Binding}">

                                            <materialDesign:PackIcon
                                            Kind="PencilOutline"
                                            Width="15"
                                            Height="15"/>

                                        </Button>


                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                        ToolTip="Delete"
                                        Click="DeleteGivingButton_Click"
                                        Tag="{Binding}">

                                            <materialDesign:PackIcon
                                            Kind="DeleteOutline"
                                            Width="15"
                                            Height="15"/>

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>
</UserControl>
