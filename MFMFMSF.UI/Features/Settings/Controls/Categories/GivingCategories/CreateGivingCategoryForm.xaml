<UserControl x:Class="MFMFMSF.UI.Features.Settings.Controls.Categories.GivingCategories.CreateGivingCategoryForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              Background="{DynamicResource TransparentBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CATEGORY NAME LABEL -->
            <TextBlock Grid.Column="0"
                       Text="Category Name"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>

            <!-- CATEGORY NAME INPUT -->
            <Border Grid.Column="1"
                    Height="36"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                <TextBox
                    Text="{Binding CategoryName,
                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                   UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center"
                    Padding="10,0"
                    FontSize="10"
                    Foreground="{DynamicResource InputForegroundBrush}"
                     Background="{DynamicResource TransparentBrush}"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource InputForegroundBrush}"
                    ToolTip="Enter giving category name"/>

            </Border>

            <!-- CREATE BUTTON -->
            <Button Grid.Column="2"
                    Click="GivingCategoryActionButton_Click"
                    Height="36"
                    MinWidth="100"
                    Margin="15,0,0,0"
                    Padding="16,0"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="10"
                    FontWeight="SemiBold">

                <Button.Template>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ActionButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <materialDesign:PackIcon
                                    Kind="{Binding ButtonIcon,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"/>

                                <TextBlock
                                    Text="{Binding ButtonText,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"/>

                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>

                            <!-- PRESSED -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>

                            <!-- DISABLED -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>
    </Border>
</UserControl>
