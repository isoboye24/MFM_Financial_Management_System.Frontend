<UserControl x:Class="MFMFMSF.UI.Features.Settings.Controls.Categories.CategoriesTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc2="clr-namespace:MFMFMSF.UI.Features.Settings.Controls.Categories.GivingCategories"
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Features.Settings.Controls.Categories.MeetingCategories"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="0,20,0,0"
          Background="{DynamicResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE TITLE -->
        <Border Grid.Row="0"
                Background="{DynamicResource TransparentBrush}"
                CornerRadius="15"
                Margin="0,0,0,30">

            <TextBlock Text="Categories"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Border>

        <!-- CATEGORY SECTIONS -->
        <Border Grid.Row="1"
                Background="{DynamicResource TransparentBrush}"
                CornerRadius="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MEETING CATEGORIES -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TableBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="15"
                                Margin="0,0,0,20">

                            <TextBlock Text="Meeting Categories"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="10"
                                Margin="0,0,0,10">

                            <lvc1:CreateMeetingCategoryForm
                                x:Name="CreateMeetingCategoryControl"
                                ButtonText="Create"
                                ButtonIcon="Plus"
                                ActionClicked="CreateMeetingCategoryControl_ActionClicked"/>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="10"
                                Margin="0,0,0,10">

                            <lvc1:MeetingCategoriesList
                                x:Name="MeetingCategoriesListControl"
                                EditClicked="MeetingCategoriesListControl_EditClicked"/>
                        </Border>

                    </Grid>
                </Border>

                <!-- SPACING COLUMN -->
                <Border Grid.Column="1"
                       Background="{DynamicResource TransparentBrush}"/>

                <!-- GIVING CATEGORIES -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TableBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="15"
                                Margin="0,0,0,20">

                            <TextBlock Text="Giving Categories"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="10"
                                Margin="0,0,0,10">

                            <lvc2:CreateGivingCategoryForm
                                x:Name="CreateGivingCategoryControl"
                                ButtonText="Create"
                                ButtonIcon="Plus"
                                ActionClicked="CreateGivingCategoryControl_ActionClicked"/>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="10"
                                Margin="0,0,0,10">

                            <lvc2:GivingCategoriesList
                                x:Name="GivingCategoriesListControl"
                                EditGivingClicked="GivingCategoriesListControl_EditClicked"/>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
