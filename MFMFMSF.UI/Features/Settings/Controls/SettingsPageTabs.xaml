<UserControl x:Class="MFMFMSF.UI.Features.Settings.Controls.SettingsPageTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>

        <!-- ================================================= -->
        <!-- TAB BUTTON STYLE -->
        <!-- ================================================= -->

        <Style x:Key="SettingsTabButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="#303653"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid>

        <Border Background="White"
                BorderBrush="#E8EAF2"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- GENERAL -->
                <!-- ================================================= -->

                <Button Grid.Column="0"
                        Tag="0"
                        Click="Tab_Click"
                        Style="{StaticResource SettingsTabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="CogOutline"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="General"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- MEETING CATEGORIES -->
                <!-- ================================================= -->

                <Button Grid.Column="1"
                        Tag="1"
                        Click="Tab_Click"
                        Style="{StaticResource SettingsTabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="CalendarTextOutline"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Meeting Categories"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>
                
                <!-- ================================================= -->
                <!-- MEETING CATEGORIES -->
                <!-- ================================================= -->

                <Button Grid.Column="2"
                        Tag="2"
                        Click="Tab_Click"
                        Style="{StaticResource SettingsTabButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="DeleteOutline"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock Text="Deleted Data"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- ACTIVE TAB INDICATOR -->
                <!-- ================================================= -->

                <Border x:Name="SettingsActiveIndicator"
                        Grid.Column="0"
                        Height="2"
                        Background="#5B4CF3"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="8,0,8,0"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>