<UserControl x:Class="MFMFMSF.UI.Features.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Settings.Views"
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:lvc2="clr-namespace:MFMFMSF.UI.Features.Settings.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20"
          Background="{DynamicResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource TableBorderBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Margin="0,0,0,20">

            <lvc1:PageTopBarWithoutButton
                PageTitle="Settings"
                PageDescription="View and manage application settings."/>

        </Border>

        <!-- SETTINGS SECTION -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource TableBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <!-- Tabs -->
                    <RowDefinition Height="50"/>

                    <!-- Settings content -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SETTINGS TABS -->
                <lvc2:SettingsPageTabs
                    Grid.Row="0"
                    SelectedIndex="0"
                    SettingsTabChanged="SettingsPageTabs_TabChanged"/>

                <!-- SETTINGS CONTENT -->
                <ContentControl
                    x:Name="SettingsContent"
                    Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"/>

            </Grid>

        </Border>

    </Grid>
</UserControl>
