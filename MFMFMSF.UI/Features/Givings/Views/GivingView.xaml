<UserControl x:Class="MFMFMSF.UI.Features.Givings.Views.GivingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
    xmlns:lv1="clr-namespace:MFMFMSF.UI.Converters"
    xmlns:lv2="clr-namespace:MFMFMSF.UI.Features.Givings.Views">

    <!-- ========================================================= -->
    <!-- RESOURCES -->
    <!-- ========================================================= -->

    <UserControl.Resources>

        <lv1:TruncateTextConverter x:Key="TruncateTextConverter"/>

        <!-- ===================================================== -->
        <!-- HEADER STYLE -->
        <!-- ===================================================== -->

        <Style x:Key="TableHeaderStyle"
       TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <!-- ===================================================== -->
        <!-- TABLE ACTION BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="TableActionButtonStyle"
       TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background"
            Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{DynamicResource PrimaryHoverBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{DynamicResource PrimaryPressedBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================================================== -->
        <!-- DELETE BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="DeleteActionButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource TableActionButtonStyle}">
            <Setter Property="Foreground"
            Value="{DynamicResource DangerBrush}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                    Value="{DynamicResource DangerHoverBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- ===================================================== -->
        <!-- FILTER COMBO BOX -->
        <!-- ===================================================== -->

        <Style x:Key="TableFilterStyle"
       TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
            Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- ===================================================== -->
        <!-- SEARCH BOX -->
        <!-- ===================================================== -->

        <Style x:Key="TableSearchStyle"
       TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
            Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource TableBorderBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <!-- FILTERS -->
                <RowDefinition Height="Auto"/>

                <!-- TABLE HEADER -->
                <RowDefinition Height="38"/>

                <!-- TABLE DATA -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- FILTERS -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
          Margin="0,0,0,12">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <TextBox Grid.Column="0"
                 Width="220"
                 HorizontalAlignment="Left"
                 Style="{DynamicResource TableSearchStyle}"
                 Text=""/>


            </Grid>


            <!-- ================================================= -->
            <!-- TABLE HEADER -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
            Style="{DynamicResource TableHeaderContainer}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="0,1,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.2*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                       Text="Category"
                       Style="{DynamicResource TableHeaderStyle}"
                       Margin="8,0"/>

                    <TextBlock Grid.Column="1" 
                       Text="Amount"
                       Style="{DynamicResource TableHeaderStyle}"
                       HorizontalAlignment="Left"/>


                    <TextBlock Grid.Column="2"
                       Text="Summary"
                       Style="{DynamicResource TableHeaderStyle}"
                       HorizontalAlignment="Left"/>


                    <TextBlock Grid.Column="3"
                       Text="Actions"
                       Style="{StaticResource TableHeaderStyle}"
                       HorizontalAlignment="Center"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- TABLE DATA -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Givings}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border BorderBrush="{DynamicResource TableBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.2*"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- GIVING CATEGORY -->

                                    <TextBlock Grid.Column="0"
                                       Text="{Binding CategoryName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                       Margin="8,0"/>

                                    <!-- AMOUNT -->

                                    <TextBlock Grid.Column="1"
                                       Text="{Binding Amount, StringFormat=€ {0:N2}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>


                                    <!-- SUMMARY -->

                                    <TextBlock Grid.Column="2"
                                       Text="{Binding Summary,
                                                  Converter={StaticResource TruncateTextConverter},
                                                  ConverterParameter=30}"
                                       FontSize="12"
                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>

                                    <!-- ACTIONS -->

                                    <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">


                                        <!-- VIEW -->

                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                        Command="{Binding ViewGivingCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="View">

                                            <materialDesign:PackIcon
                                        Kind="EyeOutline"
                                        Width="14"
                                        Height="14"/>

                                        </Button>


                                        <!--EDIT-->

                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                        Command="{Binding EditGivingCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type lv2:GivingView}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Edit">

                                            <materialDesign:PackIcon
                                        Kind="PencilOutline"
                                        Width="14"
                                        Height="14"/>

                                        </Button>


                                         <!--DELETE-->

                                        <Button Style="{StaticResource DeleteActionButtonStyle}"
                                        Command="{Binding DeleteGivingCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Delete">

                                            <materialDesign:PackIcon
                                        Kind="DeleteOutline"
                                        Width="14"
                                        Height="14"/>

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>
</UserControl>
