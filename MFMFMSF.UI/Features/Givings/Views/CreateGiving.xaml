<UserControl x:Class="MFMFMSF.UI.Features.Givings.Views.CreateGiving"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:MFMFMSF.UI.Features.Givings.Views" 
         xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"          
         xmlns:viewmodels="clr-namespace:MFMFMSF.UI.Features.Givings.ViewModels" 
        xmlns:controls2="clr-namespace:MFMFMSF.UI.Features.Givings.Controls.Form" d:DataContext="{d:DesignInstance Type=viewmodels:CreateGivingViewModel}"
         mc:Ignorable="d" 
         d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#F5F7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Margin="0,0,0,20">

            <controls:FormTitle
            BreadcrumbText="Church Giving"
            CurrentPageText="Create Giving"
            Title="Create Giving"
            Description="Create a new church giving to track and manage contributions."
            NavigationService="{Binding NavigationService,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </Border>

        <Border Grid.Row="1"
            Margin="0,0,0,20">

            <controls2:GivingForm
            GivingDate="{Binding Date, Mode=TwoWay}"
            GivingCategories="{Binding GivingCategories}"
            SelectedGivingCategory="{Binding SelectedGivingCategory, Mode=TwoWay}"
            Amount="{Binding Amount, Mode=TwoWay}"
            MeetingId="{Binding MeetingId, Mode=OneWay}"
            Summary="{Binding Summary, Mode=TwoWay}"/>

        </Border>

        <Border Grid.Row="2"
            Margin="0,0,0,20">

            <controls:SendFormButton
            Text="Save Church Giving"
            Icon="ContentSave"
            Command="{Binding SaveGivingCommand}"/>

        </Border>

    </Grid>
</UserControl>
