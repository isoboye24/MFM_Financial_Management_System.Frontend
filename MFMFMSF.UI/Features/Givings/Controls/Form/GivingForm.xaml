<UserControl x:Class="MFMFMSF.UI.Features.Givings.Controls.Form.GivingForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         Background="Transparent">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- LABEL -->
        <!-- ===================================================== -->

        <Style x:Key="FormLabel"
           TargetType="TextBlock">

            <Setter Property="FontSize"
                Value="12"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Foreground"
                Value="#151936"/>

            <Setter Property="Margin"
                Value="0,0,0,5"/>

        </Style>


        <!-- ===================================================== -->
        <!-- HELPER TEXT -->
        <!-- ===================================================== -->

        <Style x:Key="FormHelperText"
           TargetType="TextBlock">

            <Setter Property="FontSize"
                Value="8"/>

            <Setter Property="Foreground"
                Value="#68708A"/>

            <Setter Property="Margin"
                Value="0,5,0,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TEXT BOX -->
        <!-- ===================================================== -->

        <Style x:Key="FormTextBox"
           TargetType="TextBox">

            <Setter Property="Height"
                Value="36"/>

            <Setter Property="FontSize"
                Value="9"/>

            <Setter Property="Foreground"
                Value="#303653"/>

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Padding"
                Value="10,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBO BOX -->
        <!-- ===================================================== -->

        <Style x:Key="FormComboBox"
           TargetType="ComboBox">

            <Setter Property="Height"
                Value="36"/>

            <Setter Property="FontSize"
                Value="9"/>

            <Setter Property="Foreground"
                Value="#303653"/>

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Padding"
                Value="8,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DATE PICKER -->
        <!-- ===================================================== -->

        <Style x:Key="FormDatePicker"
           TargetType="DatePicker">

            <Setter Property="Height"
                Value="36"/>

            <Setter Property="FontSize"
                Value="9"/>

            <Setter Property="Foreground"
                Value="#303653"/>

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
                Value="1"/>

        </Style>


        <!-- ===================================================== -->
        <!-- NUMBER BOX -->
        <!-- ===================================================== -->

        <Style x:Key="NumberBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource FormTextBox}">

            <Setter Property="TextAlignment"
                Value="Left"/>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border Background="White"
        BorderBrush="#E8EAF2"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <!-- TITLE -->
                <RowDefinition Height="Auto"/>

                <!-- FORM -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

                <TextBlock Text="Create New Giving"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#151936"/>

                <TextBlock Text="Enter the details of the giving."
                       FontSize="11"
                       Foreground="#68708A"
                       Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================================= -->
                        <!-- DATE -->
                        <!-- ================================================= -->
                        <StackPanel Grid.Row="0"
                             Grid.Column="0"
                             Margin="0,0,0,12">

                            <TextBlock Text="Date *"
                                Style="{StaticResource FormLabel}"/>

                            <DatePicker
                                SelectedDate="{Binding GivingDate,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Style="{StaticResource FormDatePicker}"/>      

                            <TextBlock Text="Select the date of the giving."
                                Style="{StaticResource FormHelperText}"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- GIVING CATEGORY -->
                        <!-- ================================================= -->
                        <StackPanel Grid.Row="0"
                             Grid.Column="2"
                             Margin="0,0,0,12">

                            <TextBlock Text="Giving Category *"
                                Style="{StaticResource FormLabel}"/>

                            <ComboBox
                                 ItemsSource="{Binding GivingCategories,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 SelectedItem="{Binding SelectedGivingCategory,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Style="{StaticResource FormComboBox}"
                                 ToolTip="Select the category of this giving"/> 

                            <TextBlock Text="Select the category of this giving."
                                Style="{StaticResource FormHelperText}"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- AMOUNT -->
                        <!-- ================================================= -->
                        <StackPanel Grid.Row="0"
                             Grid.Column="4"
                             Margin="0,0,0,12">

                            <TextBlock Text="Amount"
                                Style="{StaticResource FormLabel}"/>

                            <TextBox
                                 Text="{Binding Amount,
                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Enter the amount of the giving."
                                Style="{StaticResource FormHelperText}"/>

                        </StackPanel>
                    </Grid>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->
                <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,10,0,0">

                    <TextBlock
                        Text="Summary"
                        Style="{StaticResource FormLabel}"
                        Margin="0,0,0,20"/>

                    <TextBox
                        Height="70"
                        Width="Auto"
                        Text="{Binding Summary,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}" 
                    FontSize="12"
                    Foreground="#303653"
                    Background="White"
                    BorderBrush="#DDE1EC"
                    BorderThickness="1"
                    Padding="10"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalContentAlignment="Top"
                    HorizontalAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"/>

                    <TextBlock
                        Text="Enter the giving details or additional notes."
                        Style="{StaticResource FormHelperText}"
                        Margin="0,5,0,0"/>

                </StackPanel>


            </Grid>

        </Grid>

    </Border>

</UserControl>
