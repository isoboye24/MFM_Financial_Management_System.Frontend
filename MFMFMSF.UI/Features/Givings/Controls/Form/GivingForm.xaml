<UserControl x:Class="MFMFMSF.UI.Features.Givings.Controls.Form.GivingForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         Background="Transparent">

    <UserControl.Resources>


        <!-- LABEL -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
         Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- HELPER TEXT -->
        <Style x:Key="FormHelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
         Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- TEXT BOX -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
         Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
         Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
         Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- ================================================ -->
        <!-- COMBOBOX -->
        <!-- ================================================ -->

        <Style x:Key="AppComboBoxItem"
    TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground"
         Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
         Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                     Background="{TemplateBinding Background}"
                     Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                     VerticalAlignment="Center"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                             Property="Background"
                             Value="{DynamicResource PrimaryHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                             Property="Background"
                             Value="{DynamicResource PrimaryPressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppComboBox"
    TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
         Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
         Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
         Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="ItemContainerStyle"
         Value="{DynamicResource AppComboBoxItem}"/>
        </Style>



        <!-- ================================================ -->
        <!-- DATEPICKER INTERNAL TEXT BOX -->
        <!-- ================================================ -->

        <Style x:Key="AppDatePickerTextBox"
    TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground"
         Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
         Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
         Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- ================================================ -->
        <!-- DATEPICKER -->
        <!-- ================================================ -->



        <Style x:Key="AppDatePicker"
    TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
         Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
         Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
         Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>





        <!-- NUMBER BOX -->
        <Style x:Key="NumberBoxStyle"
    TargetType="TextBox"
    BasedOn="{StaticResource FormTextBox}">
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>


    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource TableBorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <!-- TITLE -->
                <RowDefinition Height="Auto"/>

                <!-- FORM -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

                <TextBlock Text="Create New Giving"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Enter the details of the giving."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================================= -->
                        <!-- DATE -->
                        <!-- ================================================= -->
                        <StackPanel Grid.Row="0"
                             Grid.Column="0"
                             Margin="0,0,0,12">

                            <TextBlock Text="Date *"
                                Style="{StaticResource FormLabel}"/>

                            <DatePicker
                                SelectedDate="{Binding GivingDate,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Style="{DynamicResource AppDatePicker}"/>      

                            <TextBlock Text="Select the date of the giving."
                                Style="{DynamicResource FormHelperText}"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- GIVING CATEGORY -->
                        <!-- ================================================= -->
                        <StackPanel Grid.Row="0"
                             Grid.Column="2"
                             Margin="0,0,0,12">

                            <TextBlock Text="Giving Category *"
                                Style="{StaticResource FormLabel}"/>

                            <ComboBox
                                 ItemsSource="{Binding GivingCategories,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 SelectedItem="{Binding SelectedGivingCategory,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Style="{DynamicResource AppComboBox}"
                                 ToolTip="Select the category of this giving"/> 

                            <TextBlock Text="Select the category of this giving."
                                Style="{DynamicResource FormHelperText}"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- AMOUNT -->
                        <!-- ================================================= -->
                        <StackPanel Grid.Row="0"
                             Grid.Column="4"
                             Margin="0,0,0,12">

                            <TextBlock Text="Amount"
                                Style="{DynamicResource FormLabel}"/>

                            <TextBox
                                 Text="{Binding Amount,
                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource FormTextBox}"/>

                            <TextBlock Text="Enter the amount of the giving."
                                Style="{DynamicResource FormHelperText}"/>

                        </StackPanel>
                    </Grid>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->
                <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,10,0,0">

                    <TextBlock
                        Text="Summary"
                        Style="{DynamicResource FormLabel}"
                        Margin="0,0,0,20"/>

                    <TextBox
                        Height="70"
                        Width="Auto"
                        Text="{Binding Summary,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}" 
                    FontSize="12"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="10"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalContentAlignment="Top"
                    HorizontalAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"/>

                    <TextBlock
                        Text="Enter the giving details or additional notes."
                        Style="{DynamicResource FormHelperText}"
                        Margin="0,5,0,0"/>

                </StackPanel>


            </Grid>

        </Grid>

    </Border>

</UserControl>
