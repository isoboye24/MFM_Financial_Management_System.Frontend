<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Views.CreateMeeting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Meetings.Views" 
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:controls2="clr-namespace:MFMFMSF.UI.Features.Meetings.Controls.Form"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="#F5F7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,20">
            
            <controls:FormTitle
                BreadcrumbText="Church Service"
                CurrentPageText="Create Service"
                Title="Create Service"
                Description="Create a new church service to track and manage contributions."
                NavigationService="{Binding NavigationService,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            
        </Border>
        
        <Border Grid.Row="1"
                Margin="0,0,0,20">
            
            <controls2:MeetingForm
                MeetingDate="{Binding Date}"
                Summary="{Binding Summary}"
                MessageTitle="{Binding MessageTitle}"
                MinisterName="{Binding MinisterName}"
                MaleAttendance="{Binding MaleAttendance}"
                FemaleAttendance="{Binding FemaleAttendance}"
                ChildrenAttendance="{Binding ChildrenAttendance}"
                Message="{Binding Message}"/> 
            
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,20">
            
            <controls:SendFormButton
                Text="Save Church Service"
                Icon="ContentSave"
                Command="{Binding SaveMeetingCommand}"/>
            
        </Border>
        
    </Grid>
</UserControl>
