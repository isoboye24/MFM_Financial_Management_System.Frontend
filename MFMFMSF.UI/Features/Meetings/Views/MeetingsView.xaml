<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Views.MeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Meetings.Views" 
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Controls" 
             xmlns:lv2="clr-namespace:MFMFMSF.UI.Features.Meetings.Controls" 
             xmlns:lv3="clr-namespace:MFMFMSF.UI.Features.Meetings.Controls.ViewMeeting"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Height="Auto"
            Background="White"
            CornerRadius="15"
            Margin="0,0,0,20">

            <lvc1:PageTopBar
                PageTitle="Church Services"
                PageDescription="View and manage all services of the church."
                DateRangeText="May 1 – May 31, 2025"
                ActionText="Add Church Service"
                ActionCommand="{Binding AddMeetingCommand}"
                DateRangeCommand="{Binding SelectDateRangeCommand}"/>

        </Border>

        <Border Grid.Row="1"
            Height="Auto"
            CornerRadius="15"
            Padding="2"
            Margin="0,0,0,20">

            <lvc1:StatisticCards/>

        </Border>
        
        <Border Grid.Row="2"
            Height="Auto"
            CornerRadius="15"
            Padding="2"
            Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0"
                    Height="Auto"                       
                    CornerRadius="15">
                    <lv2:MeetingsTable
                        Meetings="{Binding DataContext.Meetings,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                        NavigationService="{Binding DataContext.NavigationService,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                        MeetingCategoryService="{Binding DataContext.MeetingCategoryService,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        MeetingService="{Binding DataContext.MeetingService,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Border>
                
                <Border Grid.Column="2"
                    Height="Auto"                       
                    CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="200"
                                Margin="0,0,0,20">
                            <lv3:MaleAttendanceTrend/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
