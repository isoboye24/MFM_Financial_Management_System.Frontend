<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Views.ViewMeeting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Meetings.Views" 
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Controls" 
             xmlns:lvc2="clr-namespace:MFMFMSF.UI.Features.Meetings.Controls.ViewMeeting"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
                     Background="#F5F7FB">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
             Height="Auto"
             Background="White"
             CornerRadius="15"
             Margin="0,0,0,20">

            <lvc1:PageTitleBarWithCreateButton
                BreadcrumbText="Church Service"
                CurrentPageText="View Service"
                Title="View Service"
                Description="View all the information of today's service."
                ActionText="Add Giving"
                ActionIcon="Plus"
                ActionCommand="{Binding AddGivingCommand}"
                NavigationService="{Binding NavigationService,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </Border>

        <Border Grid.Row="1"
            Height="Auto"
            CornerRadius="15"
            Margin="0,0,0,20">

            <lvc2:SingleMeetingTopCards/>

        </Border>
        
        <Border Grid.Row="2"
            Height="Auto"
            CornerRadius="15"
            Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Height="Auto"
                    CornerRadius="15">

                    <lvc2:ViewMeetingGivingsTable/>

                </Border>

                <Border Grid.Column="2"
                    Height="Auto"
                    CornerRadius="15">

                    <lvc2:ViewMeetingSideCards/>

                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
