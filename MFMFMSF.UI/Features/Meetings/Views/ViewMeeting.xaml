<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Views.ViewMeeting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Meetings.Views"
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:lvc2="clr-namespace:MFMFMSF.UI.Features.Meetings.Controls.ViewMeeting"
             xmlns:lvc3="clr-namespace:MFMFMSF.UI.Features.Givings.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20"
          Background="{DynamicResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE TITLE -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Margin="0,0,0,20"
                Padding="20">

            <lvc1:PageTitleBarWithCreateButton
                BreadcrumbText="Church Service"
                CurrentPageText="View Service Details"
                Title="View Service Details"
                Description="View all the information of today's service."
                ActionText="Add Giving"
                ActionIcon="Plus"
                ActionCommand="{Binding AddGivingCommand}"
                NavigationService="{Binding NavigationService,
                    RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </Border>

        <!-- MEETING SUMMARY CARDS -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource AppBackgroundBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Margin="0,0,0,20">

            <lvc2:SingleMeetingTopCards/>

        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="15"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MEETING DETAILS AND GIVINGS -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="15">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- MEETING DATA -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <lvc2:ViewMeetingData/>

                        </Border>

                        <!-- GIVING RECORDS -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <lvc3:GivingView
                                Givings="{Binding Givings}"
                                NavigationService="{Binding NavigationService,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:ViewMeeting}}}"
                                GivingCategoryService="{Binding GivingCategoryService,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:ViewMeeting}}}"
                                GivingService="{Binding GivingService,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:ViewMeeting}}}"/>

                        </Border>
                    </Grid>
                </Border>

                <!-- SIDE CARDS -->
                <Border Grid.Column="2"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBackgroundBrush}"
                        BorderThickness="1"
                        CornerRadius="12">

                    <lvc2:ViewMeetingSideCards
                        Meeting="{Binding Meeting}"/>

                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>