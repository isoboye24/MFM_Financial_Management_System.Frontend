<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Controls.SingleMeetingTopCards"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
                xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"> 
    <Grid>
        <UniformGrid Columns="5"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

            <!-- TOTAL TITHES -->
            <controls:SummaryCard
                 Margin="8"
                 Title="Total Tithes"
                 Amount="€ 1,050"
                 Percentage="12.5%"
                 Comparison="vs Apr 1 – Apr 30"
                 TrendArrow="↑"
                 TrendForeground="#0DAA68"
                 Icon="Cash"
                 IconBackground="#EEE7FF"
                 IconForeground="#6941E8"/>


            <!-- TOTAL OFFERINGS -->
            <controls:SummaryCard
                 Margin="8"
                 Title="Total Offerings"
                 Amount="€ 650"
                 Percentage="10.3%"
                 Comparison="vs Apr 1 – Apr 30"
                 TrendArrow="↑"
                 TrendForeground="#0DAA68"
                 Icon="CashMultiple"
                 IconBackground="#E2EEFF"
                 IconForeground="#3478E5"/>


            <!-- TOTAL SEEDS -->
            <controls:SummaryCard
                 Margin="8"
                 Title="Total Seeds"
                 Amount="€ 300"
                 Percentage="8.7%"
                 Comparison="vs Apr 1 – Apr 30"
                 TrendArrow="↑"
                 TrendForeground="#0DAA68"
                 Icon="Sprout"
                 IconBackground="#E1F5EC"
                 IconForeground="#42A979"/>


            <!-- TOTAL NEWCOMMERS -->
            <controls:SummaryCard
                 Margin="8"
                 Title="Total Newcommers"
                 Amount="3"
                 Percentage="5.2%"
                 Comparison="vs Apr 1 – Apr 30"
                 TrendArrow="↑"
                 TrendForeground="#0DAA68"
                 Icon="Human"
                 IconBackground="#FFE9C7"
                 IconForeground="#FF9D20"/>


            <!-- TOTAL WORKERS -->
            <controls:SummaryCard
                 Margin="3"
                 Title="Total Workers"
                 Amount="3"
                 Percentage="9.1%"
                 Comparison="vs Apr 1 – Apr 30"
                 TrendArrow="↑"
                 TrendForeground="#0DAA68"
                 Icon="People"
                 IconBackground="#FFE5EE"
                 IconForeground="#E65B89"/>

        </UniformGrid>
    </Grid>
</UserControl>
