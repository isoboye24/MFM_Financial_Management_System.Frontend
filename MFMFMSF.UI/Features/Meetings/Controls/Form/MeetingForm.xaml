<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Controls.Form.MeetingForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- LABEL -->
        <!-- ===================================================== -->

        <Style x:Key="FormLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#151936"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

        </Style>


        <!-- ===================================================== -->
        <!-- HELPER TEXT -->
        <!-- ===================================================== -->

        <Style x:Key="FormHelperText"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="8"/>

            <Setter Property="Foreground"
                    Value="#68708A"/>

            <Setter Property="Margin"
                    Value="0,5,0,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TEXT BOX -->
        <!-- ===================================================== -->

        <Style x:Key="FormTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="Foreground"
                    Value="#303653"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBO BOX -->
        <!-- ===================================================== -->

        <Style x:Key="FormComboBox"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="Foreground"
                    Value="#303653"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DATE PICKER -->
        <!-- ===================================================== -->

        <Style x:Key="FormDatePicker"
               TargetType="DatePicker">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="Foreground"
                    Value="#303653"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE1EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ===================================================== -->
        <!-- NUMBER BOX -->
        <!-- ===================================================== -->

        <Style x:Key="NumberBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FormTextBox}">

            <Setter Property="TextAlignment"
                    Value="Left"/>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <!-- TITLE -->
                <RowDefinition Height="Auto"/>

                <!-- FORM -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,15">

                <TextBlock Text="Create New Church Service"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#151936"/>

                <TextBlock Text="Enter the details of the church meeting."
                           FontSize="11"
                           Foreground="#68708A"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Grid.RowDefinitions>

                    <!-- ROW 1 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 2 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 3 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 4 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 5 -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- DATE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Date *"
                               Style="{StaticResource FormLabel}"/>

                    <DatePicker
                        SelectedDate="{Binding MeetingDate,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource FormDatePicker}"/>

                    <TextBlock Text="Select the date of the meeting."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MEETING CATEGORY -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Meeting Category *"
                               Style="{StaticResource FormLabel}"/>

                    <ComboBox
                        SelectedItem="{Binding SelectedMeetingCategory,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource FormComboBox}">

                        <ComboBoxItem Content="Sunday Meeting"/>
                        <ComboBoxItem Content="Bible Study"/>
                        <ComboBoxItem Content="Prayer Meeting"/>
                        <ComboBoxItem Content="Workers Meeting"/>
                        <ComboBoxItem Content="Youth Meeting"/>
                        <ComboBoxItem Content="Fasting &amp; Prayer"/>
                        <ComboBoxItem Content="Special Meeting"/>

                    </ComboBox>

                    <TextBlock Text="Select the category of this meeting."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Summary *"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding Summary,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Provide a short summary of the meeting."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MESSAGE TITLE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Message Title"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding MessageTitle,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Enter the title of the message or sermon."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MINISTER -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Minister Name"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding MinisterName,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Enter the name of the minister."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MALE ATTENDANCE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Male Attendance"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding MaleAttendance,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource NumberBoxStyle}"/>

                    <TextBlock Text="Number of male attendees."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- FEMALE ATTENDANCE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Female Attendance"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding FemaleAttendance,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource NumberBoxStyle}"/>

                    <TextBlock Text="Number of female attendees."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- CHILDREN ATTENDANCE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Children Attendance"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding ChildrenAttendance,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource NumberBoxStyle}"/>

                    <TextBlock Text="Number of children attendees."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MESSAGE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <TextBlock Text="Message"
                               Style="{StaticResource FormLabel}"/>

                    <TextBox
                        Text="{Binding Message,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Height="70"
                        FontSize="9"
                        Foreground="#303653"
                        Background="White"
                        BorderBrush="#DDE1EC"
                        BorderThickness="1"
                        Padding="10"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Enter the message details or additional notes."
                               Style="{StaticResource FormHelperText}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>