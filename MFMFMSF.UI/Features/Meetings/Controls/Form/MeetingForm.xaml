<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Controls.Form.MeetingForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <UserControl.Resources>


        <!-- LABEL -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- HELPER TEXT -->
        <Style x:Key="FormHelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
            Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- TEXT BOX -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- ================================================ -->
        <!-- COMBOBOX -->
        <!-- ================================================ -->

        <Style x:Key="AppComboBoxItem"
       TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        VerticalAlignment="Center"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource PrimaryHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource PrimaryPressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppComboBox"
       TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
            Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="ItemContainerStyle"
            Value="{DynamicResource AppComboBoxItem}"/>
        </Style>



        <!-- ================================================ -->
        <!-- DATEPICKER INTERNAL TEXT BOX -->
        <!-- ================================================ -->

        <Style x:Key="AppDatePickerTextBox"
       TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- ================================================ -->
        <!-- DATEPICKER -->
        <!-- ================================================ -->



        <Style x:Key="AppDatePicker"
       TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
            Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
            Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>





        <!-- NUMBER BOX -->
        <Style x:Key="NumberBoxStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource FormTextBox}">
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>


    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border  Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <!-- TITLE -->
                <RowDefinition Height="Auto"/>

                <!-- FORM -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,15">

                <TextBlock Text="Create New Church Service"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Enter the details of the church meeting."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Grid.RowDefinitions>

                    <!-- ROW 1 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 2 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 3 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 4 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 5 -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- DATE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Date *"
                               Style="{DynamicResource FormLabel}"/>

                    <DatePicker
                        SelectedDate="{Binding MeetingDate,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{DynamicResource AppDatePicker}"/>

                    <TextBlock Text="Select the date of the meeting."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MEETING CATEGORY -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Meeting Category *"
                               Style="{DynamicResource FormLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding MeetingCategories,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedItem="{Binding SelectedMeetingCategory,
                                               RelativeSource={RelativeSource AncestorType=UserControl},
                                               Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        Style="{DynamicResource AppComboBox}"
                        ToolTip="Select the category of this meeting"/>

                    <TextBlock Text="Select the category of this meeting."
                               Style="{DynamicResource FormHelperText}"/>
                </StackPanel>

                <!-- ================================================= -->
                <!-- MESSAGE TITLE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Message Title"
                               Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding MessageTitle,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the title of the message or sermon."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MINISTER -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Minister Name"
                               Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding MinisterName,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the name of the minister."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MALE ATTENDANCE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Male Attendance"
                               Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding MaleAttendance,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource NumberBoxStyle}"/>

                    <TextBlock Text="Number of male attendees."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- FEMALE ATTENDANCE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,0,0,12">

                    <TextBlock Text="Female Attendance"
                               Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding FemaleAttendance,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource NumberBoxStyle}"/>

                    <TextBlock Text="Number of female attendees."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- CHILDREN ATTENDANCE -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Children Attendance"
                               Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding ChildrenAttendance,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource NumberBoxStyle}"/>

                    <TextBlock Text="Number of children attendees."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3"
                            Grid.Column="2">

                    <TextBlock Text="Summary"
                               Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding Summary,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       UpdateSourceTrigger=PropertyChanged}"
                        Height="70"
                        FontSize="9"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Enter the message details or additional notes."
                               Style="{DynamicResource FormHelperText}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>