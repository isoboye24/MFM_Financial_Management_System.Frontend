<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Controls.ViewMeeting.MaleAttendanceTrend"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:lvc1="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Border Background="{DynamicResource SurfaceBrush}"
    BorderBrush= "{DynamicResource TableBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
          Margin="0,0,0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <TextBlock Grid.Column="0"
                   Text="Male Attendance Trend"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground= "{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center"/>


                <!-- PERIOD BUTTON -->

                <Border Grid.Column="1"
                Width="68"
                Height="25"
                Background= "{DynamicResource AppBackgroundBrush}"
                BorderBrush= "{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">

                    <!-- Selected reporting year -->
                    <Border Grid.Column="1"
        MinWidth="68"
        Height="25"
        Background= "{DynamicResource AppBackgroundBrush}"
        BorderBrush= "{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="5"
        Padding="8,0">

                        <TextBlock Text="{Binding SelectedYear, StringFormat=Year: {0}}"
               FontSize="9"
               Foreground= "{DynamicResource PrimaryTextBrush}"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>

                    </Border>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- CHART -->
            <!-- ================================================= -->

            <lvc1:CartesianChart Grid.Row="1"
                        Background="{DynamicResource TransparentBrush}"
                        Series="{Binding Series}"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}"
                        LegendPosition="Hidden"
                        ZoomMode="None"
                        TooltipPosition="Top"
                        AnimationsSpeed="0:0:0.5"
                        DrawMarginFrame="{x:Null}"
                        Margin="0,0,0,0"/>

        </Grid>

    </Border>
</UserControl>
