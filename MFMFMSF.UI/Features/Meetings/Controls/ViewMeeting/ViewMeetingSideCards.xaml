<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Controls.ViewMeeting.ViewMeetingSideCards"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
            xmlns:controls="clr-namespace:MFMFMSF.UI.Controls">
    <Grid>
        <UniformGrid Rows="5"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

            <!-- TOTAL MALE -->
             <controls:PlainSideCard
                Margin="8"
                Title="Total Male"
                Amount="{Binding Meeting.NoOfMaleAttendance,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                Icon="HumanMaleMale"
                IconBackground="#EEE7FF"
                IconForeground="#6941E8"/>


            <!-- TOTAL FEMALE -->
            <controls:PlainSideCard
             Margin="8"
             Title="Total Female"
              Amount="{Binding Meeting.NoOfFemaleAttendance,
                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                 StringFormat={}{0}}"
            
             Icon="HumanFemaleFemale"
             IconBackground="#E2EEFF"
             IconForeground="#3478E5"/>


            <!-- TOTAL CHILDREN -->
            <controls:PlainSideCard
             Margin="8"
             Title="Total Children"
             Amount="{Binding Meeting.NoOfChildrenAttendance,
                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                 StringFormat={}{0}}"
             Icon="HumanChild"
             IconBackground="#E1F5EC"
             IconForeground="#42A979"/>


            <!-- TOTAL ATTENDANCE -->
            <controls:PlainSideCard
             Margin="8"
             Title="Total Attendance"
              Amount="{Binding Meeting.TotalAttendance,
                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                 StringFormat={}{0}}"
             Icon="PersonMultiple"
             IconBackground="#FFE9C7"
             IconForeground="#FF9D20"/>


            

        </UniformGrid>
    </Grid>
</UserControl>
