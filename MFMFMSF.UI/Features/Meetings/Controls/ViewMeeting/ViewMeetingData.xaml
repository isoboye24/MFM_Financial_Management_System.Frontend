<UserControl x:Class="MFMFMSF.UI.Features.Meetings.Controls.ViewMeeting.ViewMeetingData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="800"
              Background="{DynamicResource AppBackgroundBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="15"
            Padding="24">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- SERVICE HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="{Binding Meeting.MessageTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        TextWrapping="Wrap"/>

                    <Border
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="5"
                        Padding="9,4"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="TagOutline"
                                Width="13"
                                Height="13"
                                Foreground="#5B4CF3"
                                Margin="0,0,5,0"/>

                            <TextBlock
                                Text="{Binding Meeting.MeetingCategory}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#5B4CF3"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- DATE -->

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right">

                    <TextBlock
                        Text="Service Date"
                        FontSize="12"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                        HorizontalAlignment="Right"/>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,5,0,0">

                        <materialDesign:PackIcon
                            Kind="CalendarOutline"
                            Width="15"
                            Height="15"
                            Foreground="#5B4CF3"
                            Margin="0,0,6,0"/>

                        <TextBlock
                            Text="{Binding Meeting.Date,
                                           StringFormat='{}{0:MMM d, yyyy}'}"
                            FontSize="11"
                            FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- DIVIDER -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource TableBorderBrush}"/>


            <!-- ================================================= -->
            <!-- MINISTER -->
            <!-- ================================================= -->

            <Grid Grid.Row="2"
                  Margin="0,20,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border
                    Width="38"
                    Height="38"
                    Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="19">

                    <materialDesign:PackIcon
                        Kind="AccountTieOutline"
                        Width="19"
                        Height="19"
                        Foreground="{DynamicResource MutedTextBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Minister"
                        FontSize="14"
                        Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock
                        Text="{Binding Meeting.Minister}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Margin="0,3,0,0"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- SUMMARY TITLE -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Row="3"
                Text="Service Summary"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Margin="0,0,0,10"/>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <Border
                Grid.Row="4"
               Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TableBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                VerticalAlignment="Top">

                <TextBlock
                    Text="{Binding Meeting.Summary}"
                    FontSize="12"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    TextWrapping="Wrap"
                    LineHeight="20"/>

            </Border>

        </Grid>

    </Border>

</UserControl>