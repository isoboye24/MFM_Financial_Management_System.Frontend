<UserControl x:Class="MFMFMSF.UI.Features.Seeds.Controls.RecentSeed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Seeds.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="0"
                       Text="Recent Seed Commitments"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#151936"
                       Margin="0,0,0,10"/>


            <!-- ================================================= -->
            <!-- COLUMN HEADERS -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Member"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#68708A"/>

                <TextBlock Grid.Column="1"
                           Text="Commitment Amount"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#68708A"/>

                <TextBlock Grid.Column="2"
                           Text="Start Date"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#68708A"/>

            </Grid>


            <!-- ================================================= -->
            <!-- RECORDS -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="2">


                <!-- JOHN DOE -->

                <Grid Height="25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="John Doe"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="$100.00"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Jan 1, 2025"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- MARY SMITH -->

                <Grid Height="25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Mary Smith"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="$50.00"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Feb 15, 2025"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- YOUTH MINISTRY -->

                <Grid Height="25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Youth Ministry"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="$200.00"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Mar 1, 2025"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- GRACE WOMEN FELLOWSHIP -->

                <Grid Height="25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Grace Women Fellowship"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="$150.00"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Apr 1, 2025"
                               FontSize="9"
                               Foreground="#151936"
                               VerticalAlignment="Center"/>

                </Grid>

            </StackPanel>


            <!-- ================================================= -->
            <!-- VIEW ALL -->
            <!-- ================================================= -->

            <Button Grid.Row="3"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Cursor="Hand">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="View All Commitments"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#5B4CF3"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="→"
                               FontSize="15"
                               Foreground="#5B4CF3"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

    </Border>

</UserControl>