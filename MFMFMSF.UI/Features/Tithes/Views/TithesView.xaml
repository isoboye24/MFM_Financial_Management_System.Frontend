<UserControl x:Class="MFMFMSF.UI.Features.Tithes.Views.TithesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Tithes.Views" 
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:lvc2="clr-namespace:MFMFMSF.UI.Features.Tithes.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                Height="Auto"
                Background="White"
                CornerRadius="15"
                Margin="0,0,0,20">

                <lvc1:PageTopBar
                    PageTitle="Tithe"
                    PageDescription="View and manage all tithes given to the church."
                    DateRangeText="May 1 – May 31, 2025"
                    ActionText="Add Tithe"
                    ActionCommand="{Binding AddTitleCommand}"
                    DateRangeCommand="{Binding SelectDateRangeCommand}"/>

            </Border>

            <Border Grid.Row="1"
                Height="Auto"
                CornerRadius="15"
                Padding="2"
                Margin="0,0,0,20">

                <lvc1:StatisticCards/>

            </Border>

            <Border Grid.Row="2">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                Height="Auto"
                CornerRadius="15"
                Padding="2">

                        <lvc2:TitheTable/>                        

                    </Border>

                    <Border Grid.Column="1"
                Height="Auto"
                CornerRadius="15"
                Padding="2">

                        <lvc2:TitheSideCards/>

                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
