<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Dashboard.Views" xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             Padding="20"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            
        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <controls:StatCard
                    Title="Total Offerings"
                    Amount="$28,450.00"
                    Percentage="12.5%"
                    ComparisonText="vs Apr"
                    IconKind="Church"/>
            </Grid>
            
            <Grid Grid.Column="1">
                <controls:StatCard
                    Title="Total Offerings"
                    Amount="$28,450.00"
                    Percentage="12.5%"
                    ComparisonText="vs Apr"
                    IconKind="Church"/>
            </Grid>
            
            <Grid Grid.Column="2">
                <controls:StatCard
                    Title="Total Offerings"
                    Amount="$28,450.00"
                    Percentage="12.5%"
                    ComparisonText="vs Apr"
                    IconKind="Church"/>
            </Grid>
            
            <Grid Grid.Column="3">
                <controls:StatCard
                    Title="Total Offerings"
                    Amount="$28,450.00"
                    Percentage="12.5%"
                    ComparisonText="vs Apr"
                    IconKind="Church"/>
            </Grid>
            
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="White" Margin="10"></Grid>
            <Grid Grid.Column="2" Background="White" Margin="10"></Grid>
        </Grid>
        
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="White" Margin="10"></Grid>
            <Grid Grid.Column="2" Background="White" Margin="10"></Grid>
        </Grid>
    </Grid>
</UserControl>
