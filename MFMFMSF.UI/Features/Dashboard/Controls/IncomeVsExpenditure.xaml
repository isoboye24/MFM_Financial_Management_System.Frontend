<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.IncomeVsExpenditure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="800">

    <UserControl.Resources>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Lato"/>
            <Setter Property="Foreground" Value="#303653"/>
        </Style>

        <Style x:Key="ChartSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Lato"/>
            <Setter Property="Foreground" Value="#667085"/>
        </Style>

        <Style x:Key="ChartValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Lato"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            CornerRadius="12"
            BorderThickness="1"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Income vs Expenditure"
                           Style="{StaticResource ChartTitleStyle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="PeriodSelector"
                          Width="105"
                          Height="28"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          Style="{DynamicResource ComboBoxStyle}"
                          SelectionChanged="PeriodSelector_SelectionChanged">

                    <ComboBoxItem Content="This Month" Tag="ThisMonth"/>
                    <ComboBoxItem Content="Last Month" Tag="LastMonth"/>
                    <ComboBoxItem Content="This Year" Tag="ThisYear"/>

                </ComboBox>
            </Grid>

            <!-- CHART AND SUMMARY -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- BAR CHART -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Plot area -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dynamic horizontal axis labels and gridlines -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding AxisLabel4}"
                                       FontSize="9"
                                       Foreground="#667085"
                                       VerticalAlignment="Top"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding AxisLabel3}"
                                       FontSize="9"
                                       Foreground="#667085"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding AxisLabel2}"
                                       FontSize="9"
                                       Foreground="#667085"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3"
                                       Text="{Binding AxisLabel1}"
                                       FontSize="9"
                                       Foreground="#667085"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4"
                                       Text="0"
                                       FontSize="9"
                                       Foreground="#667085"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- Plot -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="1"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="2"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="3"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="4"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="0,1,0,0"/>

                            <!-- Bars and their value labels -->
                            <Grid Grid.RowSpan="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Income -->
                                <Grid Grid.Column="0">
                                    <Border Width="36"
                                            Height="{Binding IncomeBarHeight}"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Background="#6654D9"
                                            CornerRadius="5,5,0,0"/>

                                    <TextBlock Text="{Binding TotalIncomeLabel}"
                                               Style="{StaticResource ChartValueStyle}"
                                               VerticalAlignment="Bottom"
                                               Margin="{Binding IncomeLabelMargin}"/>
                                </Grid>

                                <!-- Expenditure -->
                                <Grid Grid.Column="1">
                                    <Border Width="36"
                                            Height="{Binding ExpenditureBarHeight}"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Background="#EF5B83"
                                            CornerRadius="5,5,0,0"/>

                                    <TextBlock Text="{Binding TotalExpenditureLabel}"
                                               Style="{StaticResource ChartValueStyle}"
                                               VerticalAlignment="Bottom"
                                               Margin="{Binding ExpenditureLabelMargin}"/>
                                </Grid>

                                <!-- Net balance -->
                                <Grid Grid.Column="2">
                                    <Border Width="36"
                                            Height="{Binding NetBalanceBarHeight}"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Background="#35B58C"
                                            CornerRadius="5,5,0,0"/>

                                    <TextBlock Text="{Binding NetBalanceLabel}"
                                               Style="{StaticResource ChartValueStyle}"
                                               VerticalAlignment="Bottom"
                                               Margin="{Binding NetBalanceLabelMargin}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- X-axis labels -->
                    <Grid Grid.Row="1" Margin="34,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Total Income"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="9"
                                   Foreground="#667085"/>

                        <TextBlock Grid.Column="1"
                                   Text="Total Expenditure"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="9"
                                   Foreground="#667085"/>

                        <TextBlock Grid.Column="2"
                                   Text="Net Balance"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="9"
                                   Foreground="#667085"/>
                    </Grid>
                </Grid>

                <!-- RIGHT-HAND SUMMARY CARDS -->
                <StackPanel Grid.Column="2">

                    <!-- NET BALANCE -->
                    <Border MinHeight="82"
                            Background="White"
                            BorderBrush="#EAECF0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="11">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Background="#6754D9"
                                    VerticalAlignment="Top">

                                <TextBlock Text="↗"
                                           FontSize="18"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="Net Balance"
                                           Style="{StaticResource ChartSecondaryTextStyle}"
                                           FontSize="9"/>

                                <TextBlock Text="{Binding NetBalanceLabel}"
                                           Style="{StaticResource ChartTitleStyle}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding BalanceStatus}"
                                           FontSize="9"
                                           Foreground="{Binding BalanceStatusBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="10"/>

                    <!-- EXPENDITURE RATIO -->
                    <Border MinHeight="108"
                            Background="White"
                            BorderBrush="#EAECF0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="11">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#FF9D2E"
                                        VerticalAlignment="Top">

                                    <TextBlock Text="%"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                    <TextBlock Text="Income Spent"
                                               Style="{StaticResource ChartSecondaryTextStyle}"
                                               FontSize="9"/>

                                    <TextBlock Text="{Binding ExpenditureRatioLabel}"
                                               Style="{StaticResource ChartTitleStyle}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding ExpenditureRatioDescription}"
                                       FontSize="9"
                                       Foreground="#667085"
                                       Margin="45,7,0,8"
                                       TextWrapping="Wrap"/>

                            <ProgressBar Grid.Row="2"
                                 Height="7"
                                 Margin="45,0,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ExpenditureRatioProgress, Mode=OneWay}"
                                 Background="#F0F2F5"
                                 Foreground="#FF9D2E"
                                 BorderThickness="0"/> 
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
