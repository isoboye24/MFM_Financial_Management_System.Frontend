<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.QuickActionCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="250"
             d:DesignWidth="350">


    <!-- ================================================= -->
    <!-- MAIN CARD -->
    <!-- ================================================= -->

    <Border Background="#FFFFFF"
            BorderBrush="#EAECF0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="13">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Title -->
                <RowDefinition Height="Auto"/>

                <!-- Buttons -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ============================================ -->
            <!-- TITLE -->
            <!-- ============================================ -->

            <TextBlock Grid.Row="0"
                       Text="Quick Actions"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#172033"
                       Margin="0,0,0,8"/>


            <!-- ============================================ -->
            <!-- QUICK ACTION BUTTONS -->
            <!-- ============================================ -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="120"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ======================================== -->
                <!-- ROW 1 -->
                <!-- ======================================== -->


                
<!-- Add Service -->
<controls:QuickActionCard
    x:Name="AddMeetingCard"
    Grid.Row="0"
    Grid.Column="0"
    Title="Add Service"
    Icon="CalendarPlus"
    IconBackground="#6654D9"/>

<!-- Add Expenditure -->
<controls:QuickActionCard
    x:Name="AddExpenditureCard"
    Grid.Row="0"
    Grid.Column="1"
    Title="Add Expenditure"
    Icon="ReceiptTextOutline"
    IconBackground="#EF5B83"/>

<!-- Generate Report -->
<controls:QuickActionCard
    x:Name="GenerateReportCard"
    Grid.Row="0"
    Grid.Column="2"
    Title="Generate Report"
    Icon="FileDocumentOutline"
    IconBackground="#3182E8"/>


            </Grid>

        </Grid>

    </Border>

</UserControl>