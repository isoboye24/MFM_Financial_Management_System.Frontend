<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.TopWelcomeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="75"
             d:DesignWidth="1200">

    <Grid Background="#FFFFFF">

        <Grid.ColumnDefinitions>

            <!-- Greeting -->

            <ColumnDefinition Width="*"/>

            <!-- Right controls -->

            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- GREETING -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="Welcome back, Pastor John!"
                       FontFamily="Segoe UI"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Text="Give, and it will be given to you. – Luke 6:38"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#667085"
                       Margin="0,3,0,0"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- RIGHT -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">


            <!-- ================================================= -->
            <!-- MONTH / YEAR PICKER -->
            <!-- ================================================= -->

            <controls:MonthYearPicker
                Margin="0,0,12,0"
                PeriodChanged="MonthYearPicker_PeriodChanged"/>


            <!-- ================================================= -->
            <!-- NOTIFICATION -->
            <!-- ================================================= -->

            <Button Width="44"
                    Height="44"
                    Background="#FFFFFF"
                    BorderThickness="0"
                    Padding="0">

                <Grid Width="44"
                      Height="44">

                    <materialDesign:PackIcon
                        Kind="BellOutline"
                        Width="22"
                        Height="22"
                        Foreground="#344054"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>


                    <Border Width="17"
                            Height="17"
                            CornerRadius="9"
                            Background="#E83E57"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                        <TextBlock Text="3"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Button>

        </StackPanel>

    </Grid>

</UserControl>