<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.TopWelcomeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="75"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- ============================= -->
        <!-- COLORS -->
        <!-- ============================= -->

        <SolidColorBrush x:Key="PrimaryText"
                         Color="#111827"/>

        <SolidColorBrush x:Key="SecondaryText"
                         Color="#667085"/>

        <SolidColorBrush x:Key="BorderColor"
                         Color="#EAECF0"/>


        <!-- ============================= -->
        <!-- DATE BUTTON -->
        <!-- ============================= -->

        <Style x:Key="DateButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Width"
                    Value="220"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ===================================================== -->
    <!-- TOP BAR -->
    <!-- ===================================================== -->

    <Grid Background="#FFFFFF">

        <Grid.ColumnDefinitions>

            <!-- Greeting -->
            <ColumnDefinition Width="*"/>

            <!-- Right controls -->
            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- LEFT: GREETING -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="Welcome back, Pastor John!"
                       FontFamily="Segoe UI"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}"/>

            <TextBlock Text="Give, and it will be given to you. – Luke 6:38"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryText}"
                       Margin="0,3,0,0"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- RIGHT -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">


            <!-- ============================================= -->
            <!-- DATE RANGE -->
            <!-- ============================================= -->

            <Button Style="{StaticResource DateButtonStyle}"
                    Margin="0,0,12,0">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>

                    </Grid.ColumnDefinitions>


                    <!-- Calendar icon -->

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Kind="CalendarMonthOutline"
                        Width="18"
                        Height="18"
                        Foreground="#475467"
                        VerticalAlignment="Center"/>


                    <!-- Date -->

                    <TextBlock Grid.Column="1"
                               Text="May 1 – May 31, 2025"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#172033"
                               VerticalAlignment="Center"/>


                    <!-- Arrow -->

                    <materialDesign:PackIcon
                        Grid.Column="2"
                        Kind="ChevronDown"
                        Width="16"
                        Height="16"
                        Foreground="#344054"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                </Grid>

            </Button>


            <!-- ============================================= -->
            <!-- NOTIFICATION -->
            <!-- ============================================= -->

            <Button Width="44"
                    Height="44"
                    Background="#FFFFFF"
                    BorderThickness="0"
                    Padding="0">

                <Grid Width="44"
                      Height="44">


                    <!-- Bell -->

                    <materialDesign:PackIcon
                        Kind="BellOutline"
                        Width="22"
                        Height="22"
                        Foreground="#344054"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>


                    <!-- Notification badge -->

                    <Border Width="17"
                            Height="17"
                            CornerRadius="9"
                            Background="#E83E57"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0">

                        <TextBlock Text="3"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Button>

        </StackPanel>

    </Grid>

</UserControl>