<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.TopWelcomeBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Dashboard.Controls"
             mc:Ignorable="d"
             d:DesignHeight="75"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- ============================= -->
        <!-- COLORS -->
        <!-- ============================= -->

        <SolidColorBrush x:Key="PrimaryText"
                     Color="#111827"/>

        <SolidColorBrush x:Key="SecondaryText"
                     Color="#667085"/>

        <SolidColorBrush x:Key="BorderColor"
                     Color="#EAECF0"/>

        <!-- DATE BUTTON -->
        <Style x:Key="DateButtonStyle"
           TargetType="Button">

            <Setter Property="Background"
                Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Foreground"
                Value="#172033"/>

            <Setter Property="FontFamily"
                Value="Segoe UI"/>

            <Setter Property="FontSize"
                Value="11"/>

            <Setter Property="Padding"
                Value="12,0"/>

            <Setter Property="Height"
                Value="44"/>

            <Setter Property="Width"
                Value="220"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- MONTH BUTTON -->
        <Style x:Key="MonthButtonStyle"
           TargetType="Button">

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="Foreground"
                Value="#172033"/>

            <Setter Property="BorderBrush"
                Value="Transparent"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="FontFamily"
                Value="Segoe UI"/>

            <Setter Property="FontSize"
                Value="11"/>

            <Setter Property="FontWeight"
                Value="Normal"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Margin"
                Value="2"/>

            <Setter Property="Height"
                Value="34"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="MonthBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="MonthBorder"
                                    Property="Background"
                                    Value="#EEE9FF"/>

                                <Setter Property="Foreground"
                                    Value="#5B4BEB"/>

                                <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                            </Trigger>

                            <!-- PRESSED -->
                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="MonthBorder"
                                    Property="Background"
                                    Value="#DDD5FF"/>

                            </Trigger>

                            <!-- SELECTED MONTH -->
                            <Trigger Property="local:TopWelcomeBar.IsMonthSelected"
                                     Value="True">

                                                            <Setter TargetName="MonthBorder"
                                        Property="Background"
                                        Value="#EEE9FF"/>

                                                            <Setter Property="Foreground"
                                        Value="#5B4BEB"/>

                                                            <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid Background="#FFFFFF">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- GREETING -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="Welcome back, Pastor John!"
                       FontFamily="Segoe UI"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}"/>

            <TextBlock Text="Give, and it will be given to you. – Luke 6:38"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryText}"
                       Margin="0,3,0,0"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- RIGHT -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">


            <!-- ================================================= -->
            <!-- DATE BUTTON + POPUP -->
            <!-- ================================================= -->

            <Grid>

                <Button x:Name="DateButton"
                    Style="{StaticResource DateButtonStyle}"
                        Click="DateButton_Click"
                        Margin="0,0,12,0">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>

                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Kind="CalendarMonthOutline"
                            Width="18"
                            Height="18"
                            Foreground="#475467"
                            VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedPeriodText,
                                          ElementName=Root}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#172033"
                                   VerticalAlignment="Center"/>

                        <materialDesign:PackIcon
                            Grid.Column="2"
                            Kind="ChevronDown"
                            Width="16"
                            Height="16"
                            Foreground="#344054"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"/>

                    </Grid>

                </Button>


                <!-- ================================================= -->
                <!-- POPUP -->
                <!-- ================================================= -->

                <Popup x:Name="PeriodPopup"
                       PlacementTarget="{Binding ElementName=DateButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,8,0,0"
                            Width="280">

                        <StackPanel>


                            <!-- YEAR NAVIGATION -->

                            <Grid Margin="0,0,0,15">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="‹"
                                        FontSize="18"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PreviousYear_Click"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="YearText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#172033"/>

                                <Button Grid.Column="2"
                                        Content="›"
                                        FontSize="18"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="NextYear_Click"/>

                            </Grid>


                            <!-- MONTHS -->

                            <UniformGrid 
                                x:Name="MonthGrid"
                                Columns="3"
                                Rows="4">

                                <Button Content="Jan"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="1"
                                        Click="Month_Click"/>

                                <Button Content="Feb"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="2"
                                        Click="Month_Click"/>

                                <Button Content="Mar"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="3"
                                        Click="Month_Click"/>

                                <Button Content="Apr"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="4"
                                        Click="Month_Click"/>

                                <Button Content="May"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="5"
                                        Click="Month_Click"/>

                                <Button Content="Jun"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="6"
                                        Click="Month_Click"/>

                                <Button Content="Jul"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="7"
                                        Click="Month_Click"/>

                                <Button Content="Aug"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="8"
                                        Click="Month_Click"/>

                                <Button Content="Sep"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="9"
                                        Click="Month_Click"/>

                                <Button Content="Oct"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="10"
                                        Click="Month_Click"/>

                                <Button Content="Nov"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="11"
                                        Click="Month_Click"/>

                                <Button Content="Dec"
                                         Style="{StaticResource MonthButtonStyle}"
                                        Tag="12"
                                        Click="Month_Click"/>

                            </UniformGrid>


                            <!-- ACTIONS -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,15,0,0">

                                <Button Content="Cancel"
                                        Padding="12,6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="Cancel_Click"/>

                                <Button Content="Apply"
                                        Padding="14,6"
                                        Margin="8,0,0,0"
                                        Background="#5B4BEB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="Apply_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Popup>

            </Grid>


            <!-- ================================================= -->
            <!-- NOTIFICATION -->
            <!-- ================================================= -->

            <Button Width="44"
                    Height="44"
                    Background="#FFFFFF"
                    BorderThickness="0"
                    Padding="0">

                <Grid Width="44"
                      Height="44">

                    <materialDesign:PackIcon
                        Kind="BellOutline"
                        Width="22"
                        Height="22"
                        Foreground="#344054"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <Border Width="17"
                            Height="17"
                            CornerRadius="9"
                            Background="#E83E57"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                        <TextBlock Text="3"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Button>

        </StackPanel>

    </Grid>

</UserControl>