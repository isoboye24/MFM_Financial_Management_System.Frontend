<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.IncomeChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="500">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header and period selector -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Income Overview"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="PeriodSelector"
                          Grid.Column="1"
                          Width="105"
                          Height="28"
                          SelectedIndex="0"
                          FontSize="12"
                          Style="{DynamicResource ComboBoxStyle}"
                          SelectionChanged="PeriodSelector_SelectionChanged">

                    <ComboBoxItem Content="This Month"
                                  Tag="ThisMonth"/>

                    <ComboBoxItem Content="Last Month"
                                  Tag="LastMonth"/>

                    <ComboBoxItem Content="This Year"
                                  Tag="ThisYear"/>

                </ComboBox>
            </Grid>

            <!-- Donut chart and income breakdown -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Donut chart with total in the centre -->
                <Grid Grid.Column="0"
                      Width="180"
                      Height="180"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <lvc:PieChart Series="{Binding Series}"
                                  LegendPosition="Hidden"
                                  Background="Transparent"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                        <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:N0} €}"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="Total Income"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Income categories -->
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding IncomeItems}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="7"
                                         Height="7"
                                         Fill="{Binding Color}"
                                         VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="3,0,4,0"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Amount, StringFormat={}{0:N2} €}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="3,0,5,0"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Percentage, StringFormat={}{0:F1}%}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           MinWidth="35"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
