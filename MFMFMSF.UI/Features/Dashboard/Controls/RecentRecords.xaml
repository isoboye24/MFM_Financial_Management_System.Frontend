<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.RecentRecords"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Dashboard.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="800">

    <UserControl.Resources>

        <!-- ============================= -->
        <!-- COLORS -->
        <!-- ============================= -->

        <SolidColorBrush x:Key="TextPrimary"
                         Color="#172033"/>

        <SolidColorBrush x:Key="TextSecondary"
                         Color="#667085"/>

        <SolidColorBrush x:Key="BorderColor"
                         Color="#EAECF0"/>

        <SolidColorBrush x:Key="IncomeColor"
                         Color="#20A56B"/>

        <SolidColorBrush x:Key="ExpenseColor"
                         Color="#EF4444"/>


        <!-- ============================= -->
        <!-- CARD SHADOW -->
        <!-- ============================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Opacity="0.07"
                          Color="#000000"/>


        <!-- ============================= -->
        <!-- HEADER STYLE -->
        <!-- ============================= -->

        <Style x:Key="ColumnHeaderStyle"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ============================= -->
        <!-- DATA TEXT -->
        <!-- ============================= -->

        <Style x:Key="DataTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ============================= -->
        <!-- CATEGORY BADGE -->
        <!-- ============================= -->

        <Style x:Key="CategoryBadge"
               TargetType="Border">

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ============================= -->
        <!-- FOOTER BUTTON -->
        <!-- ============================= -->

        <Style x:Key="ViewAllButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="#5B4BDB"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="5"/>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border Background="#FFFFFF"
            CornerRadius="12"
            BorderBrush="#EAECF0"
            BorderThickness="1"
            Padding="14"
            Effect="{StaticResource CardShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Title -->
                <RowDefinition Height="Auto"/>

                <!-- Column headers -->
                <RowDefinition Height="30"/>

                <!-- Transaction 1 -->
                <RowDefinition Height="30"/>

                <!-- Transaction 2 -->
                <RowDefinition Height="30"/>

                <!-- Transaction 3 -->
                <RowDefinition Height="30"/>

                <!-- Transaction 4 -->
                <RowDefinition Height="30"/>

                <!-- Transaction 5 -->
                <RowDefinition Height="30"/>

                <!-- Footer -->
                <RowDefinition Height="40"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="0"
                       Text="Recent Transactions"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>


            <!-- ================================================= -->
            <!-- COLUMN HEADERS -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  Background="#FAFBFC">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Date"
                           Style="{StaticResource ColumnHeaderStyle}"
                           Margin="0,0,0,0"/>


                <TextBlock Grid.Column="1"
                           Text="Description"
                           Style="{StaticResource ColumnHeaderStyle}"/>


                <TextBlock Grid.Column="2"
                           Text="Category"
                           Style="{StaticResource ColumnHeaderStyle}"/>


                <TextBlock Grid.Column="3"
                           Text="Type"
                           Style="{StaticResource ColumnHeaderStyle}"/>


                <TextBlock Grid.Column="4"
                           Text="Amount"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- TRANSACTION 1 -->
            <!-- ================================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>


                <!-- DATE -->

                <TextBlock Grid.Column="0"
                           Text="May 31, 2025"
                           Style="{StaticResource DataTextStyle}"/>


                <!-- DESCRIPTION -->

                <TextBlock Grid.Column="1"
                           Text="Sunday Offering"
                           Style="{StaticResource DataTextStyle}"/>


                <!-- CATEGORY -->

                <Border Grid.Column="2"
                        Background="#EAE7FF"
                        Style="{StaticResource CategoryBadge}">

                    <TextBlock Text="Offerings"
                               FontSize="8"
                               Foreground="#5946D2"/>

                </Border>


                <!-- TYPE -->

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="↓"
                               FontSize="13"
                               Foreground="{StaticResource IncomeColor}"
                               FontWeight="Bold"/>

                    <TextBlock Text="Income"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <!-- AMOUNT -->

                <TextBlock Grid.Column="4"
                           Text="$2,450.00"
                           Style="{StaticResource DataTextStyle}"
                           HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- TRANSACTION 2 -->
            <!-- ================================================= -->

            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="May 31, 2025"
                           Style="{StaticResource DataTextStyle}"/>


                <TextBlock Grid.Column="1"
                           Text="Tithe – John Doe"
                           Style="{StaticResource DataTextStyle}"/>


                <Border Grid.Column="2"
                        Background="#DFF7EC"
                        Style="{StaticResource CategoryBadge}">

                    <TextBlock Text="Tithes"
                               FontSize="8"
                               Foreground="#15966A"/>

                </Border>


                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="↓"
                               FontSize="13"
                               Foreground="{StaticResource IncomeColor}"
                               FontWeight="Bold"/>

                    <TextBlock Text="Income"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <TextBlock Grid.Column="4"
                           Text="$500.00"
                           Style="{StaticResource DataTextStyle}"
                           HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- TRANSACTION 3 -->
            <!-- ================================================= -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="May 30, 2025"
                           Style="{StaticResource DataTextStyle}"/>


                <TextBlock Grid.Column="1"
                           Text="Faith Promise – May"
                           Style="{StaticResource DataTextStyle}"/>


                <Border Grid.Column="2"
                        Background="#FFF0D8"
                        Style="{StaticResource CategoryBadge}">

                    <TextBlock Text="Seeds"
                               FontSize="8"
                               Foreground="#D98212"/>

                </Border>


                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="↓"
                               FontSize="13"
                               Foreground="{StaticResource IncomeColor}"
                               FontWeight="Bold"/>

                    <TextBlock Text="Income"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <TextBlock Grid.Column="4"
                           Text="$300.00"
                           Style="{StaticResource DataTextStyle}"
                           HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- TRANSACTION 4 -->
            <!-- ================================================= -->

            <Grid Grid.Row="5">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="May 29, 2025"
                           Style="{StaticResource DataTextStyle}"/>


                <TextBlock Grid.Column="1"
                           Text="Sound System Maintenance"
                           Style="{StaticResource DataTextStyle}"/>


                <Border Grid.Column="2"
                        Background="#FFE4E9"
                        Style="{StaticResource CategoryBadge}">

                    <TextBlock Text="Expenditure"
                               FontSize="8"
                               Foreground="#E23D5A"/>

                </Border>


                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="↑"
                               FontSize="13"
                               Foreground="{StaticResource ExpenseColor}"
                               FontWeight="Bold"/>

                    <TextBlock Text="Expense"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <TextBlock Grid.Column="4"
                           Text="$250.00"
                           Style="{StaticResource DataTextStyle}"
                           HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- TRANSACTION 5 -->
            <!-- ================================================= -->

            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="May 28, 2025"
                           Style="{StaticResource DataTextStyle}"/>


                <TextBlock Grid.Column="1"
                           Text="Electricity Bill"
                           Style="{StaticResource DataTextStyle}"/>


                <Border Grid.Column="2"
                        Background="#FFE4E9"
                        Style="{StaticResource CategoryBadge}">

                    <TextBlock Text="Expenditure"
                               FontSize="8"
                               Foreground="#E23D5A"/>

                </Border>


                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="↑"
                               FontSize="13"
                               Foreground="{StaticResource ExpenseColor}"
                               FontWeight="Bold"/>

                    <TextBlock Text="Expense"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="5,0,0,0"/>

                </StackPanel>


                <TextBlock Grid.Column="4"
                           Text="$180.00"
                           Style="{StaticResource DataTextStyle}"
                           HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <Button Grid.Row="7"
                    Style="{StaticResource ViewAllButton}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="View all transactions   →"/>

        </Grid>

    </Border>

</UserControl>