<UserControl x:Class="MFMFMSF.UI.Features.Dashboard.Controls.RecentRecords"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="800">

    <UserControl.Resources>

        <!-- Dashboard-specific column header typography -->
        <Style x:Key="RecentGivingHeaderText"
               TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

        </Style>

        <!-- Dashboard-specific data typography -->
        <Style x:Key="RecentGivingDataText"
               TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>

        </Style>

        <!-- Category badge reuses the shared table badge -->
        <Style x:Key="RecentGivingCategoryBadge"
               TargetType="Border"
               BasedOn="{StaticResource TableBadge}">

            <Setter Property="Background" Value="#EAE7FF"/>

        </Style>

        <!-- View all button -->
        <Style x:Key="RecentGivingViewAllButton"
               TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5"/>

        </Style>

    </UserControl.Resources>

    <!-- Main card -->
    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource TableBorderBrush}"
            BorderThickness="1"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Recent Givings"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,6"/>

            <!-- Column headers -->
            <Border Grid.Row="1"
                    Style="{StaticResource TableHeaderContainer}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Date"
                               Style="{StaticResource RecentGivingHeaderText}"/>

                    <TextBlock Grid.Column="1"
                               Text="Description"
                               Style="{StaticResource RecentGivingHeaderText}"/>

                    <TextBlock Grid.Column="2"
                               Text="Category"
                               Style="{StaticResource RecentGivingHeaderText}"/>

                    <TextBlock Grid.Column="3"
                               Text="Amount"
                               Style="{StaticResource RecentGivingHeaderText}"
                               HorizontalAlignment="Right"/>
                </Grid>

            </Border>

            <!-- Recent givings -->
            <Grid Grid.Row="2">

                <ItemsControl ItemsSource="{Binding RecentGivings}"
                              AlternationCount="2">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource TableStripedRow}"
                                    Padding="0,7">

                                <Grid MinHeight="20">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Date -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}"
                                               Style="{StaticResource RecentGivingDataText}"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Summary}"
                                               ToolTip="{Binding Summary}"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource RecentGivingDataText}"/>

                                    <!-- Category -->
                                    <Border Grid.Column="2"
                                            Style="{StaticResource RecentGivingCategoryBadge}">

                                        <TextBlock Text="{Binding CategoryName}"
                                                   FontSize="8"
                                                   Foreground="#5946D2"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- Amount -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Amount, StringFormat={}{0:N2} €}"
                                               Style="{StaticResource RecentGivingDataText}"
                                               HorizontalAlignment="Right"/>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- Empty state -->
                <TextBlock Text="No givings recorded for this period."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGivings}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

            </Grid>

            <!-- Footer --><!--
            <Button Grid.Row="3"
                    Style="{DynamicResource RecentGivingViewAllButton}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="View all transactions   →"
                    Click="ViewAllButton_Click"/>-->

        </Grid>

    </Border>

</UserControl>
