<UserControl x:Class="MFMFMSF.UI.Features.Offering.Controls.OfferingTopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="90"
             Background="#F5F7FB">

    <Grid Margin="38,0,38,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <!-- PAGE TITLE -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="Offerings"
                       FontSize="27"
                       FontWeight="SemiBold"
                       Foreground="#101432"/>

            <TextBlock Text="View and manage all offerings given to the church."
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="#68708A"/>

        </StackPanel>


        <!-- DATE RANGE -->
        <Border Grid.Column="1"
                Width="240"
                Height="46"
                Background="White"
                BorderBrush="#E7E9F2"
                BorderThickness="1"
                CornerRadius="8"
                VerticalAlignment="Center">

            <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand">

                <Grid Width="238"
                      Height="44">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>

                    <!-- Calendar icon -->
                    <TextBlock Grid.Column="0"
                               Text="▣"
                               FontSize="18"
                               Foreground="#5B4CF3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Date -->
                    <TextBlock Grid.Column="1"
                               Text="May 1 – May 31, 2025"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#171B45"
                               VerticalAlignment="Center"/>

                    <!-- Arrow -->
                    <TextBlock Grid.Column="2"
                               Text="⌄"
                               FontSize="18"
                               Foreground="#171B45"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Grid>

            </Button>

        </Border>


        <!-- RECORD OFFERING BUTTON -->
        <Button Grid.Column="3"
                Width="162"
                Height="46"
                Background="#5B4CF3"
                BorderThickness="0"
                Cursor="Hand"
                VerticalAlignment="Center">

            <Button.Template>
                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="7">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="+"
                                       FontSize="22"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,9,0"/>

                            <TextBlock Text="Add Offering"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </ControlTemplate>
            </Button.Template>

        </Button>

    </Grid>

</UserControl>