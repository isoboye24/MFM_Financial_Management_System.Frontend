<UserControl x:Class="MFMFMSF.UI.Features.Offering.Controls.OfferingStatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ICON CIRCLE -->
                <Border Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="{Binding IconBackground}">

                    <materialDesign:PackIcon
                        Kind="{Binding Icon}"
                        Width="21"
                        Height="21"
                        Foreground="{Binding IconForeground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <!-- TITLE + AMOUNT -->
                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#151936"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding Amount}"
                               Margin="0,3,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101432"/>

                </StackPanel>

            </Grid>


            <!-- BOTTOM -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">

                <!-- ARROW -->
                <TextBlock Text="↑"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#0DAA68"
                           VerticalAlignment="Center"/>

                <!-- PERCENTAGE -->
                <TextBlock Text="{Binding Percentage}"
                           Margin="3,0,7,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#0DAA68"
                           VerticalAlignment="Center"/>

                <!-- COMPARISON -->
                <TextBlock Text="{Binding Comparison}"
                           FontSize="10"
                           Foreground="#68708A"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>