<UserControl x:Class="MFMFMSF.UI.Features.Expenditures.Controls.ExpendituresTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Expenditures.Controls" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- ================================================= -->
        <!-- COLORS -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="PrimaryText"
             Color="#172033"/>

        <SolidColorBrush x:Key="SecondaryText"
             Color="#667085"/>

        <SolidColorBrush x:Key="BorderColor"
             Color="#EAECF0"/>

        <SolidColorBrush x:Key="LightBackground"
             Color="#F8F9FB"/>

        <SolidColorBrush x:Key="Purple"
             Color="#5B4BDB"/>

        <SolidColorBrush x:Key="Green"
             Color="#16A36A"/>

        <SolidColorBrush x:Key="Blue"
             Color="#3182E8"/>

        <SolidColorBrush x:Key="Orange"
             Color="#FF9D2E"/>


        <!-- ================================================= -->
        <!-- CARD SHADOW -->
        <!-- ================================================= -->

        <DropShadowEffect x:Key="CardShadow"
              BlurRadius="12"
              ShadowDepth="1"
              Opacity="0.06"
              Color="#000000"/>


        <!-- ================================================= -->
        <!-- SEARCH BOX -->
        <!-- ================================================= -->

        <Style x:Key="SearchBoxStyle"
   TargetType="Border">

            <Setter Property="Background"
        Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
        Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
        Value="1"/>

            <Setter Property="CornerRadius"
        Value="7"/>

            <Setter Property="Height"
        Value="38"/>

        </Style>


        <!-- ================================================= -->
        <!-- FILTER BUTTON -->
        <!-- ================================================= -->

        <Style x:Key="FilterButtonStyle"
   TargetType="Button">

            <Setter Property="Background"
        Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
        Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
        Value="1"/>

            <Setter Property="Foreground"
        Value="{StaticResource PrimaryText}"/>

            <Setter Property="FontFamily"
        Value="Segoe UI"/>

            <Setter Property="FontSize"
        Value="10"/>

            <Setter Property="Height"
        Value="38"/>

            <Setter Property="Padding"
        Value="12,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- TYPE BADGES -->
        <!-- ================================================= -->

        <Style x:Key="BadgeText"
   TargetType="TextBlock">

            <Setter Property="FontFamily"
        Value="Segoe UI"/>

            <Setter Property="FontSize"
        Value="9"/>

            <Setter Property="FontWeight"
        Value="SemiBold"/>

            <Setter Property="HorizontalAlignment"
        Value="Center"/>

            <Setter Property="VerticalAlignment"
        Value="Center"/>

        </Style>


        <!-- ================================================= -->
        <!-- TABLE TEXT -->
        <!-- ================================================= -->

        <Style x:Key="TableText"
   TargetType="TextBlock">

            <Setter Property="FontFamily"
        Value="Segoe UI"/>

            <Setter Property="FontSize"
        Value="9"/>

            <Setter Property="Foreground"
        Value="{StaticResource PrimaryText}"/>

            <Setter Property="VerticalAlignment"
        Value="Center"/>

        </Style>


        <Style x:Key="TableSecondaryText"
   TargetType="TextBlock"
   BasedOn="{StaticResource TableText}">

            <Setter Property="Foreground"
        Value="{StaticResource SecondaryText}"/>

            <Setter Property="FontSize"
        Value="8"/>

        </Style>


        <!-- ================================================= -->
        <!-- PAGINATION BUTTON -->
        <!-- ================================================= -->

        <Style x:Key="PageButtonStyle"
   TargetType="Button">

            <Setter Property="Width"
        Value="28"/>

            <Setter Property="Height"
        Value="28"/>

            <Setter Property="Background"
        Value="Transparent"/>

            <Setter Property="BorderThickness"
        Value="0"/>

            <Setter Property="Foreground"
        Value="{StaticResource PrimaryText}"/>

            <Setter Property="FontFamily"
        Value="Segoe UI"/>

            <Setter Property="FontSize"
        Value="9"/>

            <Setter Property="Padding"
        Value="0"/>

        </Style>

    </UserControl.Resources>


    <!-- ===================================================== -->
    <!-- TABLE CARD -->
    <!-- ===================================================== -->

    <Border Background="White"
BorderBrush="{StaticResource BorderColor}"
BorderThickness="1"
CornerRadius="9"
Effect="{StaticResource CardShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Toolbar -->
                <RowDefinition Height="58"/>

                <!-- Header -->
                <RowDefinition Height="38"/>

                <!-- Rows -->
                <RowDefinition Height="*"/>

                <!-- Footer -->
                <RowDefinition Height="52"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TOOLBAR -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
      Margin="12,8,12,8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="88"/>

                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <Border Grid.Column="0"
            Style="{StaticResource SearchBoxStyle}"
            Margin="0,0,8,0">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon
                Grid.Column="0"
                Kind="Magnify"
                Width="17"
                Height="17"
                Foreground="#667085"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                     Text="Search transactions..."
                     FontFamily="Segoe UI"
                     FontSize="9"
                     Foreground="#98A2B3"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Padding="0"/>

                    </Grid>

                </Border>


                <!-- TYPE -->

                <Button Grid.Column="1"
            Style="{StaticResource FilterButtonStyle}"
            Margin="0,0,8,0">

                    <Grid Width="105">

                        <TextBlock Text="All Types"
                       VerticalAlignment="Center"/>

                        <materialDesign:PackIcon
                Kind="ChevronDown"
                Width="15"
                Height="15"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>

                    </Grid>

                </Button>


                <!-- METHOD -->

                <Button Grid.Column="2"
            Style="{StaticResource FilterButtonStyle}"
            Margin="0,0,8,0">

                    <Grid Width="105">

                        <TextBlock Text="All Methods"
                       VerticalAlignment="Center"/>

                        <materialDesign:PackIcon
                Kind="ChevronDown"
                Width="15"
                Height="15"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>

                    </Grid>

                </Button>


                <!-- FILTERS -->

                <Button Grid.Column="3"
            Style="{StaticResource FilterButtonStyle}"
            Margin="0,0,8,0"
            Foreground="{StaticResource Purple}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                Kind="FilterVariant"
                Width="15"
                Height="15"
                Margin="0,0,6,0"/>

                        <TextBlock Text="Filters"
                       VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- EXPORT -->

                <Button Grid.Column="4"
            Style="{StaticResource FilterButtonStyle}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                Kind="DownloadOutline"
                Width="15"
                Height="15"
                Margin="0,0,6,0"/>

                        <TextBlock Text="Export"
                       VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>


