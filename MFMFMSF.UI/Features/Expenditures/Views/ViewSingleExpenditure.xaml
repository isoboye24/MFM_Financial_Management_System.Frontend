<UserControl x:Class="MFMFMSF.UI.Features.Expenditures.Views.ViewSingleExpenditure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Expenditures.Views" xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             Background="#F5F7FB">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- PAGE HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
            Margin="0,0,0,20"
                Padding="20"
                Background="White">

            <controls:FormTitle
                BreadcrumbText="Church Expenditure"
                CurrentPageText="View Expenditure Details"
                Title="View Expenditure Details"
                Description="View the complete information about this expenditure."
                NavigationService="{Binding NavigationService,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </Border>

        <!-- ================================================= -->
        <!-- EXPENDITURE INFORMATION -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
            Background="White"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height ="Auto"/>
                    <RowDefinition Height ="Auto"/>
                    <RowDefinition Height ="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">

                    <StackPanel>

                        <TextBlock
                            Text="Expenditure Information"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#151936"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Details about this church expenditure."
                            FontSize="16"
                            Foreground="#68708A"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,35"/>

                    </StackPanel>

                </Border>
                
                
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,30">

                    <StackPanel>

                        <!-- AMOUNT -->

                        <TextBlock
                            Text="Amount"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#68708A"/>

                        <TextBlock
                            Text="{Binding Expenditure.Amount, StringFormat=€ {0:N2}}"
                            FontSize="16"
                            Foreground="#303653"
                            Margin="0,5,0,30"/>

                    </StackPanel>

                </Border>
                
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,30">

                    <StackPanel>
                        <!-- DATE -->

                        <TextBlock
                            Text="Date"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#68708A"/>

                        <TextBlock
                            Text="{Binding Expenditure.Date, StringFormat={}{0:MMM d, yyyy}}"
                            FontSize="16"
                            Foreground="#303653"
                            Margin="0,5,0,0"/>

                    </StackPanel>
                    
                </Border>

                <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,30">

                    <StackPanel>
                        <!-- Summary -->

                        <TextBlock
                            Text="Summary"
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Left"
                            Foreground="#68708A"/>

                        <TextBlock
                            Text="{Binding Expenditure.Summary}"
                            FontSize="16"
                            Foreground="#303653"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>
            </Grid>

        </Border>

    </Grid>
</UserControl>
