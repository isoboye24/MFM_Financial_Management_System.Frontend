<UserControl x:Class="MFMFMSF.UI.Features.Expenditures.Views.ViewSingleExpenditure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             Background="#F5F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PAGE HEADER -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,0,20">

                <controls:FormTitle
                    BreadcrumbText="Church Expenditure"
                    CurrentPageText="View Expenditure Details"
                    Title="Expenditure Details"
                    Description="Review the details of this transaction."
                    NavigationService="{Binding NavigationService,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Border>

            <!-- EXPENDITURE DETAILS -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E8EAF2"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28">

                <StackPanel>

                    <!-- SECTION TITLE -->
                    <TextBlock Text="Transaction Information"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#151936"
                        Margin="0,0,0,22"/>

                    <!-- AMOUNT SUMMARY -->
                    <Border Background="#F8F7FF"
                            BorderBrush="#E8E3FF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,28">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="54"
                                    Height="54"
                                    Background="#EAE5FF"
                                    CornerRadius="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,18,0">

                                <TextBlock Text="€"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="#6048EE"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Total Expenditure"
                                           FontSize="14"
                                           Foreground="#68708A"
                                           Margin="0,0,0,5"/>

                                <TextBlock
                                    Text="{Binding Expenditure.Amount,
                                           StringFormat={}{0:N2} €}"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="#151936"/>

                                <TextBlock
                                    Text="{Binding Expenditure.Date,
                                           StringFormat={}{0:MMMM d, yyyy}}"
                                    FontSize="13"
                                    Foreground="#68708A"
                                    Margin="0,5,0,0"/>

                            </StackPanel>
                        </Grid>
                    </Border>




                    <!-- SUMMARY / PURPOSE -->
                    <StackPanel>

                        <TextBlock Text="Summary / Purpose"
               FontSize="19"
               FontWeight="SemiBold"
               Foreground="#151936"
               Margin="0,0,0,18"/>

                        <Border Background="#F8F9FC"
            BorderBrush="#E8EAF2"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">

                            <StackPanel>
                                <TextBlock Text="Expenditure Description"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#68708A"
                       Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding Expenditure.Summary}"
                       FontSize="15"
                       Foreground="#303653"
                       TextWrapping="Wrap"/>
                            </StackPanel>

                        </Border>

                    </StackPanel>


                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
