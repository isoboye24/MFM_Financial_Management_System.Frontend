<UserControl x:Class="MFMFMSF.UI.Features.Workers.Views.ViewWorker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1100"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>

        <!-- SECTION TITLE -->
        <Style x:Key="ProfileSectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <!-- FIELD LABEL -->
        <Style x:Key="ProfileFieldLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- FIELD VALUE -->
        <Style x:Key="ProfileFieldValue"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- INFORMATION ICON CONTAINER -->
        <Style x:Key="ProfileInfoIcon"
               TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryHoverBackgroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- PAGE HEADER -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                    Margin="0,0,0,20"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}">

                <controls:FormTitle
                    BreadcrumbText="Church Workers"
                    CurrentPageText="Worker Profile"
                    Title="Worker Profile"
                    Description="View personal and contact information of this church worker."
                    NavigationService="{Binding NavigationService,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            </Border>


            <!-- ===================================================== -->
            <!-- WORKER PROFILE HEADER -->
            <!-- ===================================================== -->

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="25"
                    Margin="0,0,0,20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- CIRCULAR PROFILE AVATAR -->

                    <Border Grid.Column="0"
                            Width="105"
                            Height="105"
                            CornerRadius="53"
                            Background="{DynamicResource PrimaryHoverBackgroundBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2"
                            VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="Account"
                            Width="52"
                            Height="52"
                            Foreground="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <!-- WORKER NAME AND DETAILS -->

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}">

                            <Run Text="{Binding Worker.FirstName}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Worker.LastName}"/>

                        </TextBlock>


                        <!-- POSITION -->

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0"
                                    VerticalAlignment="Center">

                            <materialDesign:PackIcon
                                Kind="BriefcaseOutline"
                                Width="15"
                                Height="15"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,0,7,0"/>

                            <TextBlock Text="{Binding Worker.PositionName}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                        </StackPanel>


                        <!-- GENDER AND REGISTRATION DATE -->

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,13,0,0">

                            <Border Background="{DynamicResource PrimaryHoverBackgroundBrush}"
                                    CornerRadius="5"
                                    Padding="10,5">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Kind="AccountOutline"
                                        Width="13"
                                        Height="13"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Margin="0,0,5,0"/>

                                    <TextBlock Text="{Binding Worker.GenderName}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"/>

                                </StackPanel>

                            </Border>


                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,5"
                                    Margin="9,0,0,0">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Kind="CalendarOutline"
                                        Width="13"
                                        Height="13"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Margin="0,0,5,0"/>

                                    <TextBlock
                                        Text="{Binding Worker.CreatedAt,
                                            StringFormat='Registered {0:MMM d, yyyy}'}"
                                        FontSize="11"
                                        Foreground="{DynamicResource SecondaryTextBrush}"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ===================================================== -->
            <!-- CONTACT INFORMATION -->
            <!-- ===================================================== -->

            <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25">

                <StackPanel>

                    <!-- CARD HEADING -->

                    <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,28">

                        <Border Width="42"
                    Height="42"
                    CornerRadius="11"
                    Background="{DynamicResource PrimaryHoverBackgroundBrush}">

                            <materialDesign:PackIcon
                    Kind="CardAccountPhoneOutline"
                    Width="22"
                    Height="22"
                    Foreground="{DynamicResource PrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="13,0,0,0"
                        VerticalAlignment="Center">

                            <TextBlock Text="Contact Information"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Contact details and residential address of this church worker."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- CONTACT DETAILS: TWO COLUMNS -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- ================================================= -->
                        <!-- EMAIL ADDRESS -->
                        <!-- ================================================= -->

                        <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14">

                                    <materialDesign:PackIcon
                            Kind="EmailOutline"
                            Width="19"
                            Height="19"
                            Foreground="{DynamicResource PrimaryBrush}"
                            VerticalAlignment="Center"/>

                                    <TextBlock Text="EMAIL ADDRESS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>

                                </StackPanel>

                                <TextBlock
                        Text="{Binding Worker.Email,
                            TargetNullValue='Not provided',
                            FallbackValue='Not provided'}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- PHONE NUMBER -->
                        <!-- ================================================= -->

                        <Border Grid.Row="0"
                    Grid.Column="2"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14">

                                    <materialDesign:PackIcon
                            Kind="PhoneOutline"
                            Width="19"
                            Height="19"
                            Foreground="{DynamicResource PrimaryBrush}"
                            VerticalAlignment="Center"/>

                                    <TextBlock Text="PHONE NUMBER"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>

                                </StackPanel>

                                <TextBlock
                        Text="{Binding Worker.PhoneNumber}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- RESIDENTIAL ADDRESS -->
                        <!-- ================================================= -->

                        <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="{DynamicResource PrimaryHoverBackgroundBrush}"
                            VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                            Kind="MapMarkerOutline"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                                    <TextBlock Text="RESIDENTIAL ADDRESS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,7"/>

                                    <TextBlock
                            Text="{Binding Worker.Address}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            TextWrapping="Wrap"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </StackPanel>

            </Border>


        </Grid>

    </ScrollViewer>

</UserControl>
