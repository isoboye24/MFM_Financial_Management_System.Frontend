<UserControl x:Class="MFMFMSF.UI.Features.Workers.Views.WorkersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Workers.Views" 
             xmlns:lvc1="clr-namespace:MFMFMSF.UI.Controls" 
             xmlns:lvc2="clr-namespace:MFMFMSF.UI.Features.Workers.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             Background="#F5F7FB">
    <Grid Margin="20">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
         Height="Auto"
         Background="White"
         CornerRadius="15"
         Margin="0,0,0,20">

            <lvc1:PageTopBar
             PageTitle="Workers"
             PageDescription="Manage and view all workers of the church."
             DateRangeText="May 1 – May 31, 2025"
             ActionText="Add Worker"
             ActionCommand="{Binding AddTitleCommand}"
             DateRangeCommand="{Binding SelectDateRangeCommand}"/>

        </Border>

        <Border Grid.Row="1"
            Height="Auto"
            CornerRadius="15"
            Margin="0,0,0,20">

            <lvc2:WorkersCards/>

        </Border>

        <Border Grid.Row="2"  Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Height="Auto"                       
                    CornerRadius="15">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0"
                            Height="Auto"
                            CornerRadius="15"
                            Margin="0,0,0,20">
                            
                            <lvc2:WorkersTable/>
                            
                        </Border>

                        <Border Grid.Row="1"
                            Height="Auto"
                            CornerRadius="15"
                            Margin="0,0,0,20">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                    Height="Auto"
                                    CornerRadius="15"
                                    Padding="0,0,2,0">

                                    <lvc2:MembersByDepartmentCard/>

                                </Border>
                                
                                <Border Grid.Column="2"
                                    Height="Auto"
                                    CornerRadius="15"
                                    Padding="0,0,2,0">

                                    <!--<lvc2:NewWorkersTrend/>-->

                                </Border>
                                
                                <Border Grid.Column="4"
                                    Height="Auto"
                                    CornerRadius="15"
                                    Padding="0,0,2,0">

                                    <lvc2:NewWorkersTrend/>

                                </Border>
                            </Grid>

                        </Border>
                    </Grid>

                </Border>

                <Border Grid.Column="1" Padding="20,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                            Height="Auto"
                            CornerRadius="15"
                            Padding="2"
                            Margin="0,0,0,20">

                            <!--<lvc2:ProjectSideCards/>-->

                        </Border>


                        <Border Grid.Row="1"
                            Height="Auto"
                            CornerRadius="15"
                             Margin="0,0,0,20">

                            <!--<lvc2:PreviousProjects/>-->

                        </Border>

                        <Border Grid.Row="2"
                            Height="200"
                            CornerRadius="15">

                            <!--<lvc2:ExpendituresTrend/>-->

                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>


    </Grid>
</UserControl>
