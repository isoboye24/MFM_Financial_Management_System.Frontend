<UserControl x:Class="MFMFMSF.UI.Features.Workers.Controls.Form.WorkerForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Workers.Controls.Form"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             Background="{DynamicResource TransparentBrush}">
    
    <UserControl.Resources>


        <!-- LABEL -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
        Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- HELPER TEXT -->
        <Style x:Key="FormHelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
        Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- TEXT BOX -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
        Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
        Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
        Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- ================================================ -->
        <!-- COMBOBOX -->
        <!-- ================================================ -->

        <Style x:Key="AppComboBoxItem"
   TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground"
        Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
        Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                    VerticalAlignment="Center"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                            Property="Background"
                            Value="{DynamicResource PrimaryHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                            Property="Background"
                            Value="{DynamicResource PrimaryPressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppComboBox"
   TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
        Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
        Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
        Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="ItemContainerStyle"
        Value="{DynamicResource AppComboBoxItem}"/>
        </Style>



        <!-- ================================================ -->
        <!-- DATEPICKER INTERNAL TEXT BOX -->
        <!-- ================================================ -->

        <Style x:Key="AppDatePickerTextBox"
   TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground"
        Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
        Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
        Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- ================================================ -->
        <!-- DATEPICKER -->
        <!-- ================================================ -->



        <Style x:Key="AppDatePicker"
   TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
        Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background"
        Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
        Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>





        <!-- NUMBER BOX -->
        <Style x:Key="NumberBoxStyle"
   TargetType="TextBox"
   BasedOn="{StaticResource FormTextBox}">
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>


    </UserControl.Resources>

    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <Border  Background="{DynamicResource SurfaceBrush}"
    BorderBrush="{DynamicResource TableBorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12">

        <Grid>

            <Grid.RowDefinitions>

                <!-- TITLE -->
                <RowDefinition Height="Auto"/>

                <!-- FORM -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

                <TextBlock Text="Create New Church Worker"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Enter the details of the church worker."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Grid.RowDefinitions>

                    <!-- ROW 1 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 2 -->
                    <RowDefinition Height="Auto"/>

                    <!-- ROW 3 -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- FIRST NAME -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,0,12">

                    <TextBlock Text="First Name *"
                        Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding FirstName,
                        RelativeSource={RelativeSource AncestorType=UserControl},
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the first name of the worker."
                        Style="{DynamicResource FormHelperText}"/>

                </StackPanel>
                
                
                <!-- ================================================= -->
                <!-- LAST NAME -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                     Grid.Column="2"
                     Margin="0,0,0,12">

                    <TextBlock Text="Last Name *"
                        Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding LastName,
                        RelativeSource={RelativeSource AncestorType=UserControl},
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the last name of the worker."
                        Style="{DynamicResource FormHelperText}"/>

                </StackPanel>
                
                <!-- ================================================= -->
                <!-- ADDRESS -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                     Grid.Column="0"
                     Margin="0,0,0,12">

                    <TextBlock Text="Address *"
                        Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding Address,
                        RelativeSource={RelativeSource AncestorType=UserControl},
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the address of the worker."
                        Style="{DynamicResource FormHelperText}"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- PHONE NUMBER -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                     Grid.Column="2"
                     Margin="0,0,0,12">

                    <TextBlock Text="Phone Number *"
                        Style="{DynamicResource FormLabel}"/>

                    <TextBox
                        Text="{Binding PhoneNumber,
                        RelativeSource={RelativeSource AncestorType=UserControl},
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the phone number of the worker."
                        Style="{DynamicResource FormHelperText}"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- POSITIONS AND GENDERS -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Grid.Column="0">
    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================================= -->
                        <!-- POSITIONS -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="0"
                            Margin="0,0,0,12">

                            <TextBlock Text="Positions *"
                                Style="{DynamicResource FormLabel}"/>

                            <ComboBox
                                ItemsSource="{Binding Positions,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding SelectedPosition,
                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                   Mode=TwoWay}"
                                DisplayMemberPath="Name"
                                Style="{DynamicResource AppComboBox}"
                                ToolTip="Select the position of this worker"/>

                            <TextBlock Text="Select the position of this worker."
                                Style="{DynamicResource FormHelperText}"/>
                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- GENDER -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="2"
                            Margin="0,0,0,12">

                            <TextBlock Text="Gender *"
                                Style="{DynamicResource FormLabel}"/>

                            <ComboBox
                                ItemsSource="{Binding Genders,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding SelectedGender,
                                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                                       Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            Style="{DynamicResource AppComboBox}"
                            ToolTip="Select the gender of this worker"/>

                            <TextBlock Text="Select the gender of this worker."
                                Style="{DynamicResource FormHelperText}"/>
                        </StackPanel>
                    </Grid>
                    
                </Border>


                <!-- ================================================= -->
                <!-- EMAIL -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
     Grid.Column="2"
     Margin="0,0,0,12">

                    <TextBlock Text="Email"
        Style="{DynamicResource FormLabel}"/>

                    <TextBox
        Text="{Binding Email,
        RelativeSource={RelativeSource AncestorType=UserControl},
        UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource FormTextBox}"/>

                    <TextBlock Text="Enter the email of the worker."
        Style="{DynamicResource FormHelperText}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>
