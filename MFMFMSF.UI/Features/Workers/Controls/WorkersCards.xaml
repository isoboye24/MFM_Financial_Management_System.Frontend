<UserControl x:Class="MFMFMSF.UI.Features.Workers.Controls.WorkersCards"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
            xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"> 
    <Grid>
        <UniformGrid Columns="4"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- TOTAL WORKERS -->
            <controls:PlainSideCard
                Margin="8"
                Title="Total Workers"
                Amount="{Binding Worker.TotalWorkers}"
                Icon="AccountGroup"
                IconBackground="#EEE7FF"
                IconForeground="#6941E8"/>

            <!-- NEW WORKERS -->
            <controls:PlainSideCard
                Margin="8"
                Title="New Workers"
                Amount="{Binding Worker.TotalNewWorkers}"
                Icon="Person"
                IconBackground="#E1F5EC"
                IconForeground="#42A979"/>

            <!-- MALE WORKERS -->
            <controls:PlainSideCard
                Margin="8"
                Title="Total Male Workers"
                Amount="{Binding Worker.TotalMaleWorkers}"
                Icon="HumanMaleMale"
                IconBackground="#FFE9C7"
                IconForeground="#FF9D20"/>
           
            <!-- FEMALE WORKERS -->
            <controls:PlainSideCard
                Margin="8"
                Title="Total Female Workers"
                Amount="{Binding Worker.TotalFemaleWorkers}"
                Icon="HumanMaleMale"
                IconBackground="#FFE5EE"
                IconForeground="#E65B89"/>

        </UniformGrid>
    </Grid>
</UserControl>
