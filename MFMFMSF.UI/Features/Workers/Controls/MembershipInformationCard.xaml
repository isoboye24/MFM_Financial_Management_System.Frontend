<UserControl x:Class="MFMFMSF.UI.Features.Workers.Controls.MembershipInformationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MFMFMSF.UI.Features.Workers.Controls" 
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <controls:TwoColumnsInfoCard
            Width="270"
            CardTitle="Membership Information"

            Label1="Membership Type"
            Value1="Full Member"
            Value1Background="#DDF5EA"
            Value1Foreground="#0DAA68"

            Label2="Department"
            Value2="Ushering Ministry"
            Value2Background="#EEE7FF"
            Value2Foreground="#5B4CF3"

            Label3="Small Group"
            Value3="Victory Group"
            Value3Background="#E2EEFF"
            Value3Foreground="#3478E5"

            Label4="Member Status"
            Value4="Active"
            Value4Background="#DDF5EA"
            Value4Foreground="#0DAA68"/>
    </Grid>
</UserControl>
