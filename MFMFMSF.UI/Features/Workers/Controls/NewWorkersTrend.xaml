<UserControl x:Class="MFMFMSF.UI.Features.Workers.Controls.NewWorkersTrend"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:lvc1="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Border Background="White"
    BorderBrush="#E8EAF2"
    BorderThickness="1"
    CornerRadius="12"
    Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
          Margin="0,0,0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <TextBlock Grid.Column="0"
                   Text="New Workers Trend"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#151936"
                   VerticalAlignment="Center"/>


                <!-- PERIOD BUTTON -->

                <Border Grid.Column="1"
                Width="68"
                Height="25"
                Background="#F8F9FC"
                BorderBrush="#E7E9F2"
                BorderThickness="1"
                CornerRadius="5">

                    <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand">

                        <Grid Width="66"
                      Height="23">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                               Text="This Month"
                               FontSize="8"
                               Foreground="#151936"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="1"
                               Text="⌄"
                               FontSize="11"
                               Foreground="#151936"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        </Grid>

                    </Button>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- CHART -->
            <!-- ================================================= -->

            <lvc1:CartesianChart Grid.Row="1"
                        Series="{Binding Series}"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}"
                        LegendPosition="Hidden"
                        ZoomMode="None"
                        TooltipPosition="Hidden"
                        AnimationsSpeed="0:0:0.5"
                        DrawMarginFrame="{x:Null}"
                        Margin="0,0,0,0"/>

        </Grid>

    </Border>
</UserControl>
