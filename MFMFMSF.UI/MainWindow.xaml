<Window
    x:Class="MFMFMSF.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MFMFMSF.UI.Controls" xmlns:views="clr-namespace:MFMFMSF.UI.Features.Dashboard.Views"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowState="Normal"
    WindowStartupLocation="CenterScreen"
    Background="#F5F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <controls:Sidebar Grid.Column="0"/>

        <!-- Right side -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TopBar x:Name="TopBarControl" Grid.Row="0"/>

            <ScrollViewer Grid.Row="1">
                <views:DashboardView/>
            </ScrollViewer>

        </Grid>

    </Grid>

</Window>

