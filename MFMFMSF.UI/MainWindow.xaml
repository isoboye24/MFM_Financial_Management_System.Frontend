<Window
    x:Class="MFMFMSF.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MFMFMSF.UI.Controls" xmlns:views="clr-namespace:MFMFMSF.UI.Features.Dashboard.Views"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowState="Minimized"
    Background="#F5F7FB">

    <Grid>

        <Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ColumnDefinition Width="290"/>

            <!-- Main Content -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <controls:Sidebar Grid.Row="0"/>

        <!-- Main Content -->
        <Grid Grid.ColumnSpan="3" Margin="34,0,0,0">

            <Grid.RowDefinitions>

                <!-- Top Bar -->
                <RowDefinition Height="20"/>

                <!-- Welcome and Notification Bar -->
                <RowDefinition Height="80"/>

                <!-- Dashboard -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <controls:TopBar x:Name="TopBarControl" Grid.Row="0"/>

            <ScrollViewer Grid.Row="1">

                <!-- DashboardView -->
                <views:DashboardView/>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>