<UserControl x:Class="MFMFMSF.UI.Controls.MonthYearPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MFMFMSF.UI.Controls">

    <Grid>

        <!-- ================================================= -->
        <!-- DATE BUTTON + POPUP -->
        <!-- ================================================= -->

        <Button x:Name="DateButton"
                Style="{StaticResource PeriodPickerButton}"
                Click="DateButton_Click">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>


                <!-- CALENDAR -->

                <materialDesign:PackIcon
                    Grid.Column="0"
                    Kind="CalendarMonthOutline"
                    Width="18"
                    Height="18"
                    Style="{StaticResource Icon}"
                    VerticalAlignment="Center"/>


                <!-- SELECTED PERIOD -->

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding SelectedPeriodText,
                                   ElementName=Root}"
                    FontFamily="Segoe UI"
                    FontSize="11"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    VerticalAlignment="Center"/>


                <!-- ARROW -->

                <materialDesign:PackIcon
                    Grid.Column="2"
                    Kind="ChevronDown"
                    Width="16"
                    Height="16"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>

            </Grid>

        </Button>


        <!-- ================================================= -->
        <!-- POPUP -->
        <!-- ================================================= -->

        <Popup x:Name="PeriodPopup"
               PlacementTarget="{Binding ElementName=DateButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,8,0,0"
                Width="280">

                <StackPanel>


                    <!-- ========================================= -->
                    <!-- YEAR NAVIGATION -->
                    <!-- ========================================= -->

                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>


                        <Button
                            Grid.Column="0"
                            Content="‹"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PreviousYear_Click"/>


                        <TextBlock
                            Grid.Column="1"
                            x:Name="YearText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"/>


                        <Button
                            Grid.Column="2"
                            Content="›"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="NextYear_Click"/>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- MONTHS -->
                    <!-- ========================================= -->

                    <UniformGrid
                        x:Name="MonthGrid"
                        Columns="3"
                        Rows="4">

                        <Button Content="Jan"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="1"
                                Click="Month_Click"/>

                        <Button Content="Feb"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="2"
                                Click="Month_Click"/>

                        <Button Content="Mar"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="3"
                                Click="Month_Click"/>

                        <Button Content="Apr"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="4"
                                Click="Month_Click"/>

                        <Button Content="May"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="5"
                                Click="Month_Click"/>

                        <Button Content="Jun"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="6"
                                Click="Month_Click"/>

                        <Button Content="Jul"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="7"
                                Click="Month_Click"/>

                        <Button Content="Aug"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="8"
                                Click="Month_Click"/>

                        <Button Content="Sep"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="9"
                                Click="Month_Click"/>

                        <Button Content="Oct"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="10"
                                Click="Month_Click"/>

                        <Button Content="Nov"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="11"
                                Click="Month_Click"/>

                        <Button Content="Dec"
                                Style="{StaticResource PeriodMonthButton}"
                                Tag="12"
                                Click="Month_Click"/>

                    </UniformGrid>


                    <!-- ========================================= -->
                    <!-- ACTIONS -->
                    <!-- ========================================= -->

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                        <Button
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="0"
                            Height="34"
                            Padding="12,0"
                            Click="Cancel_Click"/>

                        <Button
                            Content="Apply"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="0"
                            Height="34"
                            Padding="14,0"
                            Margin="8,0,0,0"
                            Click="Apply_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>

</UserControl>