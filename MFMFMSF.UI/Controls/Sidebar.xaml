<UserControl x:Class="MFMFMSF.UI.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SidebarBackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>

            <!-- Logo -->
            <RowDefinition Height="90"/>

            <!-- Navigation -->
            <RowDefinition Height="*"/>

            <!-- User -->
            <RowDefinition Height="90"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CHURCH HEADER -->
        <!-- ===================================================== -->

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="20">

            <!-- CHURCH LOGO -->

            <Border
                Width="45"
                Height="45"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10">

                <TextBlock
                    Text="✝"
                    FontSize="24"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>


            <!-- CHURCH NAME -->

            <StackPanel
                Margin="15,0,0,0"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Mountain of "
                    Foreground="{DynamicResource SidebarTextBrush}"
                    FontWeight="Bold"
                    FontSize="18"/>

                <TextBlock
                    Text="Fire Ministries"
                    Foreground="{DynamicResource SidebarTextBrush}"
                    FontSize="18"/>

            </StackPanel>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- NAVIGATION -->
        <!-- ===================================================== -->

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="True">

            <StackPanel
                x:Name="NavigationMenu"
                Margin="0,20,0,20">


                <!-- DASHBOARD -->

                <controls:SidebarMenuItem
                    Title="Dashboard"
                    Icon="ViewDashboard"
                    Command="{Binding NavigateDashboardCommand}"
                    IsSelected="True"
                    Click="SidebarMenuItem_Click"/>


                <!-- CHURCH SERVICES -->

                <controls:SidebarMenuItem
                    Title="Church Services"
                    Icon="MonitorAccount"
                    Command="{Binding NavigateMeetingsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- OFFERINGS -->

                <controls:SidebarMenuItem
                    Title="Offerings"
                    Icon="Gift"
                    Command="{Binding NavigateOfferingsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- TITHES -->

                <controls:SidebarMenuItem
                    Title="Tithes"
                    Icon="HeartOutline"
                    Command="{Binding NavigateTithesCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- SEEDS -->

                <controls:SidebarMenuItem
                    Title="Seeds"
                    Icon="Sprout"
                    Command="{Binding NavigateSeedsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- OTHER INCOME -->

                <controls:SidebarMenuItem
                    Title="Other Income"
                    Icon="CashPlus"
                    Command="{Binding NavigateOtherIncomeCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- EXPENDITURES -->

                <controls:SidebarMenuItem
                    Title="Expenditures"
                    Icon="CashMinus"
                    Command="{Binding NavigateExpendituresCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- PROJECTS -->

                <controls:SidebarMenuItem
                    Title="Projects"
                    Icon="OfficeBuilding"
                    Command="{Binding NavigateProjectsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- WORKERS -->

                <controls:SidebarMenuItem
                    Title="Workers"
                    Icon="AccountGroup"
                    Command="{Binding NavigateWorkersCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- REPORTS -->

                <controls:SidebarMenuItem
                    Title="Reports"
                    Icon="ChartBar"
                    Command="{Binding NavigateReportsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- SETTINGS -->

                <controls:SidebarMenuItem
                    Title="Settings"
                    Icon="Cog"
                    Command="{Binding NavigateSettingsCommand}"
                    Click="SidebarMenuItem_Click"/>

            </StackPanel>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- USER PROFILE -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"
            Background="Transparent"/>

    </Grid>

</UserControl>