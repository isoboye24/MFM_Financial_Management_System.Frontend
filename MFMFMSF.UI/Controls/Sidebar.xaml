<UserControl x:Class="MFMFMSF.UI.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#171B45">

    <Grid>

        <Grid.RowDefinitions>
            <!-- Logo -->
            <RowDefinition Height="90"/>

            <!-- Navigation -->
            <RowDefinition Height="*"/>

            <!-- User -->
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- Church Name -->
        <!-- ========================= -->

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="20">

            <Border Width="45"
                    Height="45"
                    Background="White"
                    CornerRadius="10">

                <TextBlock Text="✝"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <StackPanel Margin="15,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Mountain of "
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBlock Text="Fire Ministries"
                           Foreground="White"
                           FontSize="18"/>

            </StackPanel>

        </StackPanel>

        <!-- Navigation will go here -->

        <StackPanel Grid.Row="1">

        </StackPanel>

        <!-- User Profile will go here -->

        <Border Grid.Row="2"/>

    </Grid>

</UserControl>