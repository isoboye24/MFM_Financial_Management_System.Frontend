<UserControl x:Class="MFMFMSF.UI.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SidebarBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Church Header -->
            <RowDefinition Height="150"/>

            <!-- Navigation -->
            <RowDefinition Height="*"/>

            <!-- Settings - Fixed at Bottom -->
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CHURCH HEADER -->
        <!-- ===================================================== -->

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <!-- CHURCH LOGO -->

            <Border
    Width="100"
    Height="100"
    CornerRadius="0"
    Margin="0,5,0,5"
    ClipToBounds="True"
    VerticalAlignment="Center"
    HorizontalAlignment="Center"
    Cursor="Hand"
    ToolTip="Go to Dashboard"
    MouseLeftButtonUp="ChurchLogo_MouseLeftButtonUp">

                <Image
        Source="pack://siteoforigin:,,,/Assets/Icons/ChurchLogo.png"
        Stretch="Uniform"
        RenderOptions.BitmapScalingMode="HighQuality"/>

            </Border>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- NAVIGATION -->
        <!-- ===================================================== -->

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="True">

            <StackPanel
                x:Name="NavigationMenu"
                Margin="0,20,0,20">

                <!-- DASHBOARD -->

                <controls:SidebarMenuItem
                    x:Name="DashboardMenuItem"
                    Title="Dashboard"
                    Icon="ViewDashboard"
                    Command="{Binding NavigateDashboardCommand}"
                    IsSelected="True"
                    Click="SidebarMenuItem_Click"/>


                <!-- CHURCH SERVICES -->

                <controls:SidebarMenuItem
                    Title="Church Services"
                    Icon="BookOpenBlankVariantOutline"
                    Command="{Binding NavigateMeetingsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- OFFERINGS -->

                <controls:SidebarMenuItem
                    Title="Offerings"
                    Icon="Gift"
                    Command="{Binding NavigateOfferingsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- TITHES -->

                <controls:SidebarMenuItem
                    Title="Tithes"
                    Icon="HeartOutline"
                    Command="{Binding NavigateTithesCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- SEEDS -->

                <controls:SidebarMenuItem
                    Title="Seeds"
                    Icon="Sprout"
                    Command="{Binding NavigateSeedsCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- OTHER INCOME -->

                <controls:SidebarMenuItem
                    Title="Other Income"
                    Icon="CashPlus"
                    Command="{Binding NavigateOtherIncomeCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- EXPENDITURES -->

                <controls:SidebarMenuItem
                    Title="Expenditures"
                    Icon="CashMinus"
                    Command="{Binding NavigateExpendituresCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- WORKERS -->

                <controls:SidebarMenuItem
                    Title="Workers"
                    Icon="AccountGroup"
                    Command="{Binding NavigateWorkersCommand}"
                    Click="SidebarMenuItem_Click"/>


                <!-- REPORTS -->

                <controls:SidebarMenuItem
                    Title="Reports"
                    Icon="ChartBar"
                    Command="{Binding NavigateReportsCommand}"
                    Click="SidebarMenuItem_Click"/>

            </StackPanel>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- SETTINGS - BOTTOM OF SIDEBAR -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"
            Background="Transparent"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderBrush}"
            Padding="0,8,0,8">

            <controls:SidebarMenuItem
                x:Name="SettingsMenuItem"
                Title="Settings"
                Icon="Cog"
                Command="{Binding NavigateSettingsCommand}"
                Click="SidebarMenuItem_Click"/>

        </Border>

    </Grid>

</UserControl>
