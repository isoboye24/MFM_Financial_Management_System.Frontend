<UserControl x:Class="MFMFMSF.UI.Controls.FormTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- BACK BUTTON -->
        <!-- ================================================= -->

        <Button Grid.Column="0"
                Width="34"
                Height="34"
                MinWidth="34"
                Margin="0,0,15,0"
                Padding="0"
                VerticalAlignment="Top"
                Cursor="Hand"
                Command="{Binding BackCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource SecondaryButton}"
                ToolTip="Back">

            <materialDesign:PackIcon
                Kind="ArrowLeft"
                Width="17"
                Height="17"
                Style="{StaticResource Icon}"/>

        </Button>


        <!-- ================================================= -->
        <!-- FORM CONTENT -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="1">


            <!-- ================================================= -->
            <!-- BREADCRUMB -->
            <!-- ================================================= -->

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding BreadcrumbText,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource FormBreadcrumb}"/>

                <TextBlock
                    Text="›"
                    Style="{StaticResource FormBreadcrumb}"
                    FontSize="15"
                    Margin="7,-1,7,0"/>

                <TextBlock
                    Text="{Binding CurrentPageText,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource FormBreadcrumbCurrent}"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- FORM TITLE -->
            <!-- ================================================= -->

            <TextBlock
                Text="{Binding Title,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource FormTitle}"
                Margin="0,8,0,0"/>


            <!-- ================================================= -->
            <!-- DESCRIPTION -->
            <!-- ================================================= -->

            <TextBlock
                Text="{Binding Description,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource FormDescription}"
                Margin="0,4,0,0"/>

        </StackPanel>

    </Grid>

</UserControl>