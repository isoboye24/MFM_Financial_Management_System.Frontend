<UserControl x:Class="MFMFMSF.UI.Controls.StatisticCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls">

    <Grid>
        <UniformGrid Columns="5"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">

            <!-- OFFERINGS -->
            <controls:SummaryCard
                Margin="8"
                Title="Offerings"
                Amount="{Binding MonthlyGivingStatistics.MonthlyOfferings,
                                 StringFormat={}€ {0:N2}}"
                Percentage="{Binding OfferingsTrend.Percentage}"
                Comparison="{Binding ComparisonText}"
                TrendArrow="{Binding OfferingsTrend.TrendArrow}"
                TrendForeground="{Binding OfferingsTrend.TrendForeground}"
                Icon="Gift"
                IconBackground="#EEE7FF"
                IconForeground="#6941E8"/>

            <!-- TITHES -->
            <controls:SummaryCard
                Margin="8"
                Title="Tithes"
                Amount="{Binding MonthlyGivingStatistics.MonthlyTithes,
                                 StringFormat={}€ {0:N2}}"
                Percentage="{Binding TithesTrend.Percentage}"
                Comparison="{Binding ComparisonText}"
                TrendArrow="{Binding TithesTrend.TrendArrow}"
                TrendForeground="{Binding TithesTrend.TrendForeground}"
                Icon="Heart"
                IconBackground="#E2EEFF"
                IconForeground="#3478E5"/>

            <!-- SEEDS -->
            <controls:SummaryCard
                Margin="8"
                Title="Seeds (Faith Promise)"
                Amount="{Binding MonthlyGivingStatistics.MonthlySeeds,
                                 StringFormat={}€ {0:N2}}"
                Percentage="{Binding SeedsTrend.Percentage}"
                Comparison="{Binding ComparisonText}"
                TrendArrow="{Binding SeedsTrend.TrendArrow}"
                TrendForeground="{Binding SeedsTrend.TrendForeground}"
                Icon="Sprout"
                IconBackground="#E1F5EC"
                IconForeground="#42A979"/>

            <!-- OTHER INCOME -->
            <controls:SummaryCard
                Margin="8"
                Title="Other Income"
                Amount="{Binding MonthlyGivingStatistics.MonthlyOtherIncome,
                                 StringFormat={}€ {0:N2}}"
                Percentage="{Binding OtherIncomeTrend.Percentage}"
                Comparison="{Binding ComparisonText}"
                TrendArrow="{Binding OtherIncomeTrend.TrendArrow}"
                TrendForeground="{Binding OtherIncomeTrend.TrendForeground}"
                Icon="Cash"
                IconBackground="#FFE9C7"
                IconForeground="#FF9D20"/>

            <!-- EXPENDITURES -->
            <controls:SummaryCard
                Margin="8"
                Title="Total Expenditures"
                Amount="{Binding MonthlyExpendituresStatistics.MonthlyExpenditures,
                                 StringFormat={}€ {0:N2}}"
                Percentage="{Binding ExpendituresTrend.Percentage}"
                Comparison="{Binding ComparisonText}"
                TrendArrow="{Binding ExpendituresTrend.TrendArrow}"
                TrendForeground="{Binding ExpendituresTrend.TrendForeground}"
                Icon="AccountMultiple"
                IconBackground="#FFE5EE"
                IconForeground="#E65B89"/>

        </UniformGrid>
    </Grid>
</UserControl>