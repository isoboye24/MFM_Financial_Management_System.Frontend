<UserControl x:Class="MFMFMSF.UI.Controls.StatisticCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
            xmlns:controls="clr-namespace:MFMFMSF.UI.Controls">
    <Grid>
        <UniformGrid Columns="5"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

            <!-- TOTAL OFFERINGS -->
            <controls:SummaryCard
                Margin="8"
                Title="Offerings"
                Amount="{Binding MonthlyGivingStatistics.MonthlyOfferings, StringFormat={}€ {0:N2}}"
                Percentage="12.5%"
                Comparison="vs Apr 1 – Apr 30"
                TrendArrow="↑"
                TrendForeground="#0DAA68"
                Icon="Gift"
                IconBackground="#EEE7FF"
                IconForeground="#6941E8"/>


            <!-- TITHES -->
            <controls:SummaryCard
                Margin="8"
                Title="Tithes"
                Amount="{Binding MonthlyGivingStatistics.MonthlyTithes, StringFormat={}€ {0:N2}}"
                Percentage="10.3%"
                Comparison="vs Apr 1 – Apr 30"
                TrendArrow="↑"
                TrendForeground="#0DAA68"
                Icon="Heart"
                IconBackground="#E2EEFF"
                IconForeground="#3478E5"/>


            <!-- SEEDS -->
            <controls:SummaryCard
                Margin="8"
                Title="Seeds (Faith Promise)"
                Amount="{Binding MonthlyGivingStatistics.MonthlySeeds, StringFormat={}€ {0:N2}}"
                Percentage="8.7%"
                Comparison="vs Apr 1 – Apr 30"
                TrendArrow="↑"
                TrendForeground="#0DAA68"
                Icon="Sprout"
                IconBackground="#E1F5EC"
                IconForeground="#42A979"/>
            

            <!-- OTHER OFFERINGS -->
            <controls:SummaryCard
                Margin="8"
                Title="Other Income"
                Amount="{Binding MonthlyGivingStatistics.MonthlyOtherIncome, StringFormat={}€ {0:N2}}"
                Percentage="5.2%"
                Comparison="vs Apr 1 – Apr 30"
                TrendArrow="↑"
                TrendForeground="#0DAA68"
                Icon="Cash"
                IconBackground="#FFE9C7"
                IconForeground="#FF9D20"/>


            <!-- TOTAL EXPENDITURES -->
                <controls:SummaryCard
                Margin="8"
                Title="Total Expenditures"
                Amount="€ 960.00"
                Percentage="9.1%"
                Comparison="vs Apr 1 – Apr 30"
                TrendArrow="↑"
                TrendForeground="#0DAA68"
                Icon="AccountMultiple"
                IconBackground="#FFE5EE"
                IconForeground="#E65B89"/>  

        </UniformGrid>
    </Grid>
</UserControl>
