<UserControl x:Class="MFMFMSF.UI.Controls.QuickActionButton"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Button
        Command="{Binding Command, ElementName=root}"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        Cursor="Hand"
        Padding="0">

        <Button.Template>
            <ControlTemplate TargetType="Button">

                <Border
                    x:Name="Card"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="18">

                        <Border
                            Width="54"
                            Height="54"
                            CornerRadius="27"
                            Background="{Binding IconBackground, ElementName=root}"
                            HorizontalAlignment="Center">

                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Kind="{Binding IconKind, ElementName=root}"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            Text="{Binding Title, ElementName=root}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="Black"
                            TextAlignment="Center"/>

                    </StackPanel>

                </Border>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card"
                                Property="Background"
                                Value="#F8FAFC"/>
                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Card"
                                Property="Opacity"
                                Value="0.85"/>
                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>
        </Button.Template>

    </Button>

</UserControl>