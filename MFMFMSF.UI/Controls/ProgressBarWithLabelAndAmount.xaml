<UserControl x:Class="MFMFMSF.UI.Controls.ProgressBarWithLabelAndAmount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MFMFMSF.UI.Converters">

    <UserControl.Resources>

        <converters:ProgressWidthConverter
            x:Key="ProgressWidthConverter"/>

    </UserControl.Resources>

    <Grid Height="26">

        <Grid.ColumnDefinitions>

            <!-- LABEL -->
            <ColumnDefinition Width="85"/>

            <!-- PROGRESS BAR -->
            <ColumnDefinition Width="*"/>

            <!-- AMOUNT -->
            <ColumnDefinition Width="115"/>

        </Grid.ColumnDefinitions>


        <!-- ================= LABEL ================= -->

        <TextBlock
            Grid.Column="0"
            Text="{Binding Label,
                           RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource TableText}"
            FontSize="10"
            FontWeight="SemiBold"
            VerticalAlignment="Center"/>


        <!-- ================= PROGRESS BAR ================= -->

        <ProgressBar
            Grid.Column="1"
            Height="6"
            Minimum="0"
            Maximum="100"
            Value="{Binding Percentage,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
            VerticalAlignment="Center"
            Background="{DynamicResource TableBorderBrush}"
            Foreground="{Binding BarForeground,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}">

            <ProgressBar.Template>

                <ControlTemplate TargetType="ProgressBar">

                    <Grid>

                        <!-- BACKGROUND -->

                        <Border
                            Background="{DynamicResource TableBorderBrush}"
                            CornerRadius="3"/>


                        <!-- VALUE -->

                        <Border
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="3">

                            <Border.Width>

                                <MultiBinding
                                    Converter="{StaticResource ProgressWidthConverter}">

                                    <Binding
                                        Path="Value"
                                        RelativeSource="{RelativeSource TemplatedParent}"/>

                                    <Binding
                                        Path="ActualWidth"
                                        RelativeSource="{RelativeSource TemplatedParent}"/>

                                </MultiBinding>

                            </Border.Width>

                        </Border>

                    </Grid>

                </ControlTemplate>

            </ProgressBar.Template>

        </ProgressBar>


        <!-- ================= AMOUNT ================= -->

        <TextBlock
            Grid.Column="2"
            Text="{Binding Amount,
                           RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource TableText}"
            FontSize="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>

    </Grid>

</UserControl>