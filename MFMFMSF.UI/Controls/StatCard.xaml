<UserControl x:Class="MFMFMSF.UI.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border
        Background="White"
        CornerRadius="10"
        Padding="20"
        Width="250"
        Height="135">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                ShadowDepth="2"
                Opacity="0.12"/>
        </Border.Effect>

        <StackPanel>

            <!-- Top -->
            <DockPanel LastChildFill="True">

                <Border
                    Width="50"
                    Height="50"
                    CornerRadius="25"
                    Background="#F1EEFF"
                    DockPanel.Dock="Left">

                    <materialDesign:PackIcon
                        Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Width="18"
                        Height="18"
                        Foreground="#7C5CFC"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="0,0,0,0">

                    <TextBlock
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FontSize="12"
                        Foreground="#777"/>

                    <TextBlock
                        Text="{Binding Amount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,4,0,0"
                        Foreground="#222"/>
                </StackPanel>

            </DockPanel>

            <!-- Bottom -->
            <StackPanel
                Orientation="Horizontal"
                Margin="0,20,0,0">

                <materialDesign:PackIcon
                    Kind="ArrowUp"
                    Width="15"
                    Height="15"
                    VerticalAlignment="Center"
                    Foreground="#21C56B"/>

                <TextBlock
                    Text="{Binding Percentage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="6,0,0,0"
                    FontWeight="SemiBold"
                    Foreground="#21C56B"/>

                <TextBlock
                    Text="{Binding ComparisonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="8,0,0,0"
                    Foreground="#999"/>

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>