<UserControl x:Class="MFMFMSF.UI.Controls.ProfileSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Border Style="{StaticResource SmallCard}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- PROFILE HEADER -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{DynamicResource PrimaryHoverBackgroundBrush}"
                    CornerRadius="8,8,0,0">

                <Grid Margin="12,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- PROFILE IMAGE -->

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ClipToBounds="True">

                        <Image Source="{Binding ProfileImage,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Stretch="UniformToFill"/>

                    </Border>


                    <!-- NAME / ID / STATUS -->

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding FullName,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource CardTitle}"
                            FontSize="12"/>

                        <TextBlock
                            Text="{Binding MemberId,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Margin="0,2,0,0"
                            FontSize="8"
                            Foreground="{DynamicResource PrimaryBrush}"/>

                        <Border
                            Background="{DynamicResource PrimaryPressedBackgroundBrush}"
                            CornerRadius="5"
                            Padding="6,2"
                            HorizontalAlignment="Left"
                            Margin="0,3,0,0">

                            <TextBlock
                                Text="{Binding Status,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                FontSize="7"
                                Foreground="{DynamicResource SuccessBrush}"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MEMBER INFORMATION -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  Margin="12,8,12,10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>


                <!-- PHONE -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Kind="PhoneOutline"
                        Style="{StaticResource SmallIcon}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Phone,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TableText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding PhoneLabel,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TableSecondaryText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                </Grid>


                <!-- EMAIL -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Kind="EmailOutline"
                        Style="{StaticResource SmallIcon}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Email,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TableText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"/>

                </Grid>


                <!-- JOINED DATE -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Kind="CalendarOutline"
                        Style="{StaticResource SmallIcon}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding JoinedDate,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TableText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Joined Date"
                        Style="{StaticResource TableSecondaryText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                </Grid>


                <!-- ADDRESS -->

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Kind="MapMarkerOutline"
                        Style="{StaticResource SmallIcon}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Address,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TableText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Address"
                        Style="{StaticResource TableSecondaryText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                </Grid>


                <!-- MARITAL STATUS -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Kind="CardsHeartOutline"
                        Style="{StaticResource SmallIcon}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding MaritalStatus,
                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TableText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Marital Status"
                        Style="{StaticResource TableSecondaryText}"
                        FontSize="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</UserControl>