<UserControl x:Class="MFMFMSF.UI.Controls.PageTopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:controls="clr-namespace:MFMFMSF.UI.Controls"
             Height="Auto"
             Background="#F5F7FB">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </UserControl.Resources>

    <Grid Margin="38,0,38,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- PAGE TITLE -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="{Binding PageTitle,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="27"
                       FontWeight="SemiBold"
                       Foreground="#101432"/>

            <TextBlock Text="{Binding PageDescription,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="#68708A"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- MONTH / YEAR PICKER -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="1">
            
            <controls:MonthYearPicker
                Margin="0,0,12,0"
                PeriodChanged="MonthYearPicker_PeriodChanged"/>
        
        </StackPanel>
        


        <!-- ================================================= -->
        <!-- ACTION BUTTON -->
        <!-- ================================================= -->

        <Button Grid.Column="3"
                Width="162"
                Height="46"
                Background="#5B4CF3"
                BorderThickness="0"
                Cursor="Hand"
                VerticalAlignment="Center"
                Command="{Binding ActionCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="{Binding ShowActionButton,
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BooleanToVisibilityConverter}}">

            <Button.Template>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="7">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="+"
                                       FontSize="22"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,9,0"/>

                            <TextBlock Text="{Binding ActionText,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </ControlTemplate>

            </Button.Template>

        </Button>

    </Grid>

</UserControl>