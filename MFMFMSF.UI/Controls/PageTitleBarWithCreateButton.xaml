<UserControl x:Class="MFMFMSF.UI.Controls.PageTitleBarWithCreateButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- LEFT SIDE -->
        <!-- ========================================================= -->

        <Grid Grid.Column="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- BACK BUTTON -->
            <!-- ================================================= -->

            <Button Grid.Column="0"
                    Width="34"
                    Height="34"
                    MinWidth="34"
                    Margin="0,0,15,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    Click="BackButton_Click"
                    Style="{DynamicResource  BackButton}"
                    ToolTip="Back">

                <materialDesign:PackIcon
                    Kind="ArrowLeft"
                    Width="17"
                    Height="17"
                    Style="{StaticResource Icon}"/>

            </Button>


            <!-- ================================================= -->
            <!-- FORM CONTENT -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="1">


                <!-- BREADCRUMB -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="{Binding BreadcrumbText,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource FormBreadcrumb}"/>

                    <TextBlock
                        Text="›"
                        Style="{StaticResource FormBreadcrumb}"
                        FontSize="15"
                        Margin="7,-1,7,0"/>

                    <TextBlock
                        Text="{Binding CurrentPageText,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource FormBreadcrumbCurrent}"/>

                </StackPanel>


                <!-- TITLE -->

                <TextBlock
                    Text="{Binding Title,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource FormTitle}"
                    Margin="0,8,0,0"/>


                <!-- DESCRIPTION -->

                <TextBlock
                    Text="{Binding Description,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource FormDescription}"
                    Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ========================================================= -->
        <!-- RIGHT SIDE - ACTION BUTTON -->
        <!-- ========================================================= -->

        <Button Grid.Column="1"
                Height="36"
                MinWidth="120"
                Margin="30,0,0,0"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Cursor="Hand"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding ActionCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTip="{Binding ActionText,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}">

            <StackPanel Orientation="Horizontal">

                <materialDesign:PackIcon
                    Kind="{Binding ActionIcon,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Width="14"
                    Height="14"
                    Margin="0,0,6,0"
                    Foreground="White"/>

                <TextBlock
                    Text="{Binding ActionText,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"/>

            </StackPanel>

        </Button>

    </Grid>

</UserControl>