<UserControl x:Class="MFMFMSF.UI.Controls.PageTitleBarWithCreateButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- LEFT SIDE -->
        <!-- ========================================================= -->

        <Grid Grid.Column="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- BACK BUTTON -->
            <!-- ================================================= -->

            <Button Grid.Column="0"
                    Width="34"
                    Height="34"
                    Margin="0,0,15,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    Click="BackButton_Click"
                    Background="White"
                    Foreground="#303653"
                    BorderBrush="#E8EAF2"
                    BorderThickness="1"
                    ToolTip="Back">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BackBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <materialDesign:PackIcon
                                Kind="ArrowLeft"
                                Width="17"
                                Height="17"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BackBorder"
                                        Property="Background"
                                        Value="#F1F0FF"/>

                                <Setter TargetName="BackBorder"
                                        Property="BorderBrush"
                                        Value="#5B4CF3"/>

                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BackBorder"
                                        Property="Background"
                                        Value="#E4E1FF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>


            <!-- ================================================= -->
            <!-- FORM CONTENT -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="1">

                <!-- Breadcrumb -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="{Binding BreadcrumbText,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FontSize="10"
                        Foreground="#8A90A6"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="›"
                        FontSize="15"
                        Foreground="#8A90A6"
                        Margin="7,-1,7,0"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="{Binding CurrentPageText,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#151936"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Title -->

                <TextBlock
                    Text="{Binding Title,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#101432"
                    Margin="0,8,0,0"/>


                <!-- Description -->

                <TextBlock
                    Text="{Binding Description,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="10"
                    Foreground="#68708A"
                    Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ========================================================= -->
        <!-- RIGHT SIDE -->
        <!-- ========================================================= -->

        <Button Grid.Column="1"
                Height="36"
                MinWidth="120"
                Margin="30,0,0,0"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Cursor="Hand"
                Background="#5B4CF3"
                BorderThickness="0"
                Foreground="White"
                Command="{Binding ActionCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTip="{Binding ActionText,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}">

            <Button.Template>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>

            </Button.Template>

            <StackPanel Orientation="Horizontal">

                <materialDesign:PackIcon
                    Kind="{Binding ActionIcon,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Width="14"
                    Height="14"
                    Margin="0,0,6,0"
                    Foreground="White"/>

                <TextBlock
                    Text="{Binding ActionText,
                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"/>

            </StackPanel>

        </Button>

    </Grid>

</UserControl>