<UserControl x:Class="MFMFMSF.UI.Controls.NoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border x:Name="CardBorder"
             CornerRadius="10"
        Padding="14"
        Margin="0,0,0,10"
        BorderThickness="1"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource TableBorderBrush}">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush"
                    Value="{DynamicResource TableBorderBrush}"/>

                <Style.Triggers>
                    <DataTrigger
                    Binding="{Binding IsMouseOver,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Value="True">

                        <Setter Property="Background"
                            Value="{DynamicResource PrimaryLightBrush}"/>
                        <Setter Property="BorderBrush"
                            Value="{DynamicResource PrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title, date and hover actions -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding NoteTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <!-- Actions: visible only when the card is hovered -->
                <StackPanel x:Name="ActionPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <Button Command="{Binding ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="View note"
                            Style="{DynamicResource NoteActionButtonStyle}">
                        <TextBlock Text="&#xE890;"
                                   FontFamily="Segoe MDL2 Assets"/>
                    </Button>

                    <Button Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="Edit note"
                            Style="{DynamicResource NoteActionButtonStyle}">
                        <TextBlock Text="&#xE70F;"
                                   FontFamily="Segoe MDL2 Assets"/>
                    </Button>

                    <Button Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="Delete note"
                            Style="{DynamicResource NoteActionButtonStyle}">
                        <TextBlock Text="&#xE74D;"
                                   FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>

                <!-- Date shown when actions are hidden -->
                <TextBlock x:Name="DateText"
                           Grid.Column="1"
                           Text="{Binding CreationTime, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:dd MMM yyyy}'}"
                           FontSize="10"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,8"/>

            <!-- Note content -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Note, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="48"
                       LineHeight="16"/>

        </Grid>
    </Border>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="ActionPanel"
                        Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{x:Static Visibility.Visible}"/>
                    </ObjectAnimationUsingKeyFrames>

                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="DateText"
                        Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{x:Static Visibility.Collapsed}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="ActionPanel"
                        Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{x:Static Visibility.Collapsed}"/>
                    </ObjectAnimationUsingKeyFrames>

                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="DateText"
                        Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{x:Static Visibility.Visible}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>